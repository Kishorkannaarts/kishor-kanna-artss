# Copy this file to .env and fill in your own values.
# cp .env.example .env

# ---------- Core ----------
PORT=3000
SITE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_long_random_string

# ---------- Database (MongoDB Atlas) ----------
MONGODB_URI=

# ---------- Admin login ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ---------- Image uploads (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email ----------
# Where you get notified of new orders/messages (your own inbox)
NOTIFY_EMAIL=
MAIL_FROM_NAME=Kishor Kanna Arts
# Option A: Brevo (recommended - works on hosts that block outgoing SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Option B: plain SMTP (fallback, only used if BREVO_API_KEY is not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Payments (Razorpay) ----------
# Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks (event: payment_link.paid)
# Webhook URL to enter there: <SITE_URL>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# ---------- Chat widget (Google Gemini - free tier) ----------
# Get a free key (no credit card needed) at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional - defaults to gemini-2.5-flash-lite (the fastest free-tier model)
GEMINI_MODEL=

# ---------- WhatsApp (Meta Cloud API) ----------
# developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Shared by WhatsApp ----------
# Country code (no +) used when a customer's phone number has no country
# code of its own. Defaults to 91 (India) if not set.
DEFAULT_COUNTRY_CODE=91
