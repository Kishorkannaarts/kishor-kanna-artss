# Copy this file to .env and fill in your own values.
# cp .env.example .env

# ---------- Core ----------
PORT=3000
SITE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_long_random_string

# ---------- Database (MongoDB Atlas) ----------
MONGODB_URI=

# ---------- Admin login ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ---------- Image uploads (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email ----------
# Where you get notified of new orders/messages (your own inbox)
NOTIFY_EMAIL=
MAIL_FROM_NAME=Kishor Kanna Arts
# Option A: Brevo (recommended - works on hosts that block outgoing SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Option B: plain SMTP (fallback, only used if BREVO_API_KEY is not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Payments (Razorpay) ----------
# Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks (event: payment_link.paid)
# Webhook URL to enter there: <SITE_URL>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ---------- WhatsApp (Meta Cloud API) ----------
# developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- SMS (Twilio) ----------
# console.twilio.com — Account SID + Auth Token from the dashboard,
# TWILIO_FROM_NUMBER is the number you bought/verified, in +E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Shared by WhatsApp + SMS ----------
# Country code (no +) used when a customer's phone number has no country
# code of its own. Defaults to 91 (India) if not set.
DEFAULT_COUNTRY_CODE=91
