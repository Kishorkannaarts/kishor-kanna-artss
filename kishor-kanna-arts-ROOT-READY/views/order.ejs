<% pageTitle = 'Order Now' %>
<%- include('partials/header') %>

<section class="section">
  <h2>Order Your Custom Artwork</h2>
  <p class="sub">Fill in the details below — we'll confirm your order shortly</p>

  <div class="form-box">
    <% if (success) { %>
      <div class="alert alert-success">
        Order placed successfully! Your Order ID is:<br>
        <span class="order-code"><%= success %></span><br><br>
        Save this ID — you'll need it (with your phone number) to track your order on the
        <a href="/track-order">Track Order</a> page.
      </div>
    <% } else { %>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form action="/order" method="POST" enctype="multipart/form-data" id="orderForm">
        <div id="orderFields">
        <div class="form-row">
          <div class="form-group"><label>Full Name</label><input type="text" name="name" value="<%= old.name || '' %>" required></div>
          <div class="form-group"><label>Phone Number</label><input type="text" name="phone" value="<%= old.phone || '' %>" required></div>
        </div>
        <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= old.email || '' %>"></div>
        <div class="form-row">
          <div class="form-group">
            <label>Art Type</label>
            <% const artTypeOptions = artTypes.slice(); if (old.art_type && !artTypeOptions.includes(old.art_type)) artTypeOptions.unshift(old.art_type); %>
            <select name="art_type" id="artTypeSelect" required>
              <% artTypeOptions.forEach(t => { %>
                <option value="<%= t %>" <%= old.art_type === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Size</label>
            <% const sizeOptions = sizes.slice(); if (old.size && !sizeOptions.includes(old.size)) sizeOptions.unshift(old.size); %>
            <select name="size" id="sizeSelect" required>
              <% sizeOptions.forEach(sz => { %>
                <option value="<%= sz %>" <%= old.size === sz ? 'selected' : '' %>><%= sz %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group" id="priceBox" style="background:#f7f7f7; border-radius:8px; padding:12px 16px; display:none;">
          <strong>Estimated Price: <span id="priceDisplay"></span></strong>
        </div>
        <div class="form-group">
          <label>Coupon Code (optional)</label>
          <div style="display:flex; gap:8px;">
            <input type="text" id="couponInput" placeholder="Enter coupon code" style="flex:1;">
            <button type="button" class="btn btn-outline" id="applyCouponBtn">Apply</button>
          </div>
          <small id="couponMessage" style="display:block; margin-top:6px;"></small>
        </div>
        <input type="hidden" name="coupon_code" id="couponCodeInput">
        <div class="form-group" id="customNote" style="background:#fff2cc; border:1px solid #e6cf87; border-radius:8px; padding:12px 16px; display:none;">
          Picked Custom? Tell us the size or idea in the notes below — we'll confirm the price with you before your order is final.
        </div>
        <input type="hidden" name="estimated_price" id="estimatedPriceInput">
        <input type="hidden" name="discount_percent_applied" id="discountAppliedInput">
        <input type="hidden" name="preset_price" id="presetPriceInput" value="<%= typeof presetPrice !== 'undefined' ? presetPrice : '' %>">

        <div class="form-group">
          <label>Upload Reference Photo</label>
          <input type="file" name="reference_image" accept="image/*">
        </div>
        <div class="form-group"><label>Delivery Address</label>
          <input type="text" name="address_line" placeholder="House / Street / Area" value="<%= old.address_line || '' %>" required>
        </div>
        <div class="form-row">
          <div class="form-group"><label>City</label><input type="text" name="city" value="<%= old.city || '' %>" required></div>
          <div class="form-group"><label>State</label><input type="text" name="state" value="<%= old.state || '' %>" required></div>
        </div>
        <div class="form-group"><label>Pincode</label>
          <input type="text" name="pincode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" value="<%= old.pincode || '' %>" required>
        </div>
        <div class="form-group">
          <label>Preferred Delivery Date</label>
          <input type="date" name="delivery_date" id="deliveryDate" value="<%= old.delivery_date || '' %>">
          <small id="dateWarning" style="color:#a2231d; display:none;">That date isn't available — please pick another.</small>
        </div>
        <div class="form-group"><label>Notes / Special Instructions</label><textarea name="notes"><%= old.notes || '' %></textarea></div>
        <button class="btn" type="button" id="reviewOrderBtn">Review Order</button>
        </div>

        <div id="orderPreview" style="display:none;">
          <h3 style="margin-top:0;">Review Your Order</h3>
          <p style="color:var(--muted, #777); font-size:0.9rem;">Please check everything below before confirming.</p>
          <div style="background:#f7f7f7; border-radius:8px; padding:16px; margin-bottom:16px;">
            <img id="pv_photo" style="display:none; max-width:160px; border-radius:8px; margin-bottom:12px;">
            <table style="width:100%; border-collapse:collapse; font-size:0.92rem;">
              <tr><td style="padding:6px 0; color:var(--muted, #777); width:40%;">Name</td><td id="pv_name" style="padding:6px 0;"></td></tr>
              <tr><td style="padding:6px 0; color:var(--muted, #777);">Phone</td><td id="pv_phone" style="padding:6px 0;"></td></tr>
              <tr><td style="padding:6px 0; color:var(--muted, #777);">Email</td><td id="pv_email" style="padding:6px 0;"></td></tr>
              <tr><td style="padding:6px 0; color:var(--muted, #777);">Art Type / Size</td><td id="pv_art" style="padding:6px 0;"></td></tr>
              <tr><td style="padding:6px 0; color:var(--muted, #777);">Estimated Price</td><td id="pv_price" style="padding:6px 0;"></td></tr>
              <tr id="pv_coupon_row" style="display:none;"><td style="padding:6px 0; color:var(--muted, #777);">Coupon</td><td id="pv_coupon" style="padding:6px 0;"></td></tr>
              <tr><td style="padding:6px 0; color:var(--muted, #777);">Delivery Address</td><td id="pv_address" style="padding:6px 0;"></td></tr>
              <tr><td style="padding:6px 0; color:var(--muted, #777);">Delivery Date</td><td id="pv_date" style="padding:6px 0;"></td></tr>
              <tr id="pv_notes_row" style="display:none;"><td style="padding:6px 0; color:var(--muted, #777); vertical-align:top;">Notes</td><td id="pv_notes" style="padding:6px 0;"></td></tr>
            </table>
          </div>
          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button class="btn btn-ghost" type="button" id="editOrderBtn">← Edit Details</button>
            <button class="btn" type="submit" id="confirmOrderBtn">Confirm &amp; Place Order</button>
          </div>
        </div>
      </form>
    <% } %>
  </div>
</section>

<script>
  const servicesData = <%- JSON.stringify(services || []) %>;
  const offerDiscount = <%- offerDiscount || 0 %>;
  const artTypeSelect = document.getElementById('artTypeSelect');
  const sizeSelect = document.getElementById('sizeSelect');
  const priceBox = document.getElementById('priceBox');
  const priceDisplay = document.getElementById('priceDisplay');
  const customNote = document.getElementById('customNote');
  const estimatedPriceInput = document.getElementById('estimatedPriceInput');
  const discountAppliedInput = document.getElementById('discountAppliedInput');
  const couponInput = document.getElementById('couponInput');
  const applyCouponBtn = document.getElementById('applyCouponBtn');
  const couponMessage = document.getElementById('couponMessage');
  const couponCodeInput = document.getElementById('couponCodeInput');
  let couponDiscount = 0;

  function legacyPriceKey(size) {
    const s = String(size || '').toLowerCase();
    if (s === 'a5') return 'price_a5';
    if (s === 'a4') return 'price_a4';
    if (s === 'a3') return 'price_a3';
    if (s === 'a2') return 'price_a2';
    if (s === 'custom') return 'price_custom';
    return null;
  }

  function priceForSize(service, size) {
    if (!service) return '';
    if (service.prices && service.prices[size]) return service.prices[size];
    const lk = legacyPriceKey(size);
    if (lk && service[lk]) return service[lk];
    return '';
  }

  const presetPrice = <%- JSON.stringify(typeof presetPrice !== 'undefined' ? presetPrice : '') %>;

  function getBasePrice() {
    if (presetPrice) {
      const p = parseFloat(String(presetPrice).replace(/[^0-9.]/g, ''));
      if (p) return p;
    }
    const service = servicesData.find(s => s.title === artTypeSelect.value);
    const rawPrice = priceForSize(service, sizeSelect.value);
    return parseFloat(String(rawPrice || '').replace(/[^0-9.]/g, ''));
  }

  function updatePrice() {
    if (sizeSelect.value.toLowerCase() === 'custom') {
      priceBox.style.display = 'none';
      customNote.style.display = 'block';
      estimatedPriceInput.value = '';
      discountAppliedInput.value = '';
      return;
    }
    customNote.style.display = 'none';
    const numericPrice = getBasePrice();
    if (!numericPrice) { priceBox.style.display = 'none'; estimatedPriceInput.value = ''; discountAppliedInput.value = ''; return; }
    const bestDiscount = Math.max(offerDiscount, couponDiscount);
    const discounted = bestDiscount ? numericPrice - (numericPrice * bestDiscount / 100) : numericPrice;
    priceDisplay.textContent = bestDiscount
      ? `₹${discounted.toFixed(0)} (was ₹${numericPrice.toFixed(0)}, ${bestDiscount}% off)`
      : `₹${numericPrice.toFixed(0)}`;
    priceBox.style.display = 'block';
    estimatedPriceInput.value = discounted.toFixed(0);
    discountAppliedInput.value = bestDiscount;
  }
  artTypeSelect.addEventListener('change', updatePrice);
  sizeSelect.addEventListener('change', updatePrice);
  updatePrice();

  applyCouponBtn.addEventListener('click', async function () {
    const code = couponInput.value.trim();
    if (!code) return;
    couponMessage.textContent = 'Checking...';
    couponMessage.style.color = 'var(--muted, #777)';
    try {
      const res = await fetch('/coupon/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code })
      });
      const data = await res.json();
      if (data.valid) {
        couponDiscount = data.discount_percent;
        couponCodeInput.value = code;
        couponMessage.textContent = data.message;
        couponMessage.style.color = '#1a7a3f';
      } else {
        couponDiscount = 0;
        couponCodeInput.value = '';
        couponMessage.textContent = data.message;
        couponMessage.style.color = '#a2231d';
      }
      updatePrice();
    } catch (e) {
      couponMessage.textContent = 'Could not check that coupon — please try again.';
      couponMessage.style.color = '#a2231d';
    }
  });

  const blockedDates = <%- JSON.stringify(blockedDates || []) %>;
  const dateInput = document.getElementById('deliveryDate');
  const warning = document.getElementById('dateWarning');
  const submitBtn = document.getElementById('reviewOrderBtn');
  if (dateInput) {
    dateInput.addEventListener('change', function () {
      if (blockedDates.includes(dateInput.value)) {
        warning.style.display = 'block';
        submitBtn.disabled = true;
      } else {
        warning.style.display = 'none';
        submitBtn.disabled = false;
      }
    });
  }

  // ---- Review Order step ----
  const orderForm = document.getElementById('orderForm');
  const orderFields = document.getElementById('orderFields');
  const orderPreview = document.getElementById('orderPreview');
  const reviewOrderBtn = document.getElementById('reviewOrderBtn');
  const editOrderBtn = document.getElementById('editOrderBtn');

  reviewOrderBtn.addEventListener('click', function () {
    if (!orderForm.reportValidity()) return;

    document.getElementById('pv_name').textContent = orderForm.name.value;
    document.getElementById('pv_phone').textContent = orderForm.phone.value;
    document.getElementById('pv_email').textContent = orderForm.email.value || '—';
    document.getElementById('pv_art').textContent = artTypeSelect.value + ' / ' + sizeSelect.value;
    document.getElementById('pv_price').textContent = priceDisplay.textContent || 'To be confirmed';

    const couponRow = document.getElementById('pv_coupon_row');
    if (couponCodeInput.value) {
      couponRow.style.display = '';
      document.getElementById('pv_coupon').textContent = couponCodeInput.value + ' (' + couponDiscount + '% off)';
    } else {
      couponRow.style.display = 'none';
    }

    const addressParts = [orderForm.address_line.value, orderForm.city.value, orderForm.state.value, orderForm.pincode.value].filter(Boolean);
    document.getElementById('pv_address').textContent = addressParts.join(', ');
    document.getElementById('pv_date').textContent = dateInput.value || 'Not specified';

    const notesRow = document.getElementById('pv_notes_row');
    if (orderForm.notes.value.trim()) {
      notesRow.style.display = '';
      document.getElementById('pv_notes').textContent = orderForm.notes.value;
    } else {
      notesRow.style.display = 'none';
    }

    const pvPhoto = document.getElementById('pv_photo');
    const fileInput = orderForm.querySelector('input[name="reference_image"]');
    if (fileInput.files && fileInput.files[0]) {
      const reader = new FileReader();
      reader.onload = function (e) { pvPhoto.src = e.target.result; pvPhoto.style.display = 'block'; };
      reader.readAsDataURL(fileInput.files[0]);
    } else {
      pvPhoto.style.display = 'none';
    }

    orderFields.style.display = 'none';
    orderPreview.style.display = 'block';
    orderPreview.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  editOrderBtn.addEventListener('click', function () {
    orderPreview.style.display = 'none';
    orderFields.style.display = 'block';
    orderFields.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<%- include('partials/footer') %>
