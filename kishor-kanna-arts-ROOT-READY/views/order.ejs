<% pageTitle = 'Order Now' %>
<% pageDescription = `Order a custom hand-made portrait from ${settings.site_name} in a few simple steps — choose your art type, upload a photo, and see your price instantly.` %>
<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <h2>Order Your Custom Artwork</h2>
    <p class="sub">Takes about 60 seconds — we'll confirm your order shortly</p>

    <div class="form-box wizard-box">
      <% if (success) { %>
        <div class="alert alert-success">
          Order placed successfully! Your Order ID is:<br>
          <span class="order-code"><%= success %></span><br><br>
          Save this ID — you'll need it (with your phone number) to track your order on the
          <a href="/track-order">Track Order</a> page.
        </div>
      <% } else { %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

        <!-- Progress bar -->
        <div class="wizard-progress" id="wizardProgress">
          <div class="wizard-step-dot active" data-step="1"><span>1</span><label>Art &amp; Size</label></div>
          <div class="wizard-step-dot" data-step="2"><span>2</span><label>Photo</label></div>
          <div class="wizard-step-dot" data-step="3"><span>3</span><label>Delivery</label></div>
          <div class="wizard-step-dot" data-step="4"><span>4</span><label>Review</label></div>
        </div>

        <div class="wizard-eta" id="wizardEta">⏱ About 60 seconds — you're on step <span id="wizardEtaStep">1</span> of 4</div>

        <form action="/order" method="POST" enctype="multipart/form-data" id="orderForm">
          <div id="orderFields">

            <!-- STEP 1: Art type + size + contact -->
            <div class="wizard-panel active" data-panel="1">
              <div class="form-row">
                <div class="form-group"><label>Full Name</label><input type="text" name="name" value="<%= old.name || '' %>" required></div>
                <div class="form-group"><label>Phone Number</label><input type="tel" name="phone" id="phoneInput" inputmode="numeric" pattern="[0-9]{10}" maxlength="10" placeholder="10-digit mobile number" value="<%= old.phone || '' %>" required></div>
              </div>
              <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= old.email || '' %>"></div>
              <div class="form-row">
                <div class="form-group">
                  <label>Art Type</label>
                  <% const artTypeOptions = artTypes.slice(); if (old.art_type && !artTypeOptions.includes(old.art_type)) artTypeOptions.unshift(old.art_type); %>
                  <select name="art_type" id="artTypeSelect" required>
                    <% artTypeOptions.forEach(t => { %>
                      <option value="<%= t %>" <%= old.art_type === t ? 'selected' : '' %>><%= t %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="form-group">
                  <label>Size</label>
                  <% const sizeOptions = sizes.slice(); if (old.size && !sizeOptions.includes(old.size)) sizeOptions.unshift(old.size); %>
                  <select name="size" id="sizeSelect" required>
                    <% sizeOptions.forEach(sz => { %>
                      <option value="<%= sz %>" <%= old.size === sz ? 'selected' : '' %>><%= sz %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label>Frame</label>
                <select name="frame">
                  <% ['No Frame', 'Wooden Frame', 'Premium Frame'].forEach(fr => { %>
                    <option value="<%= fr %>" <%= old.frame === fr ? 'selected' : '' %>><%= fr %></option>
                  <% }) %>
                </select>
              </div>
              <% if (old.occasion) { %><input type="hidden" name="occasion" value="<%= old.occasion %>"><% } %>

              <div class="form-group" id="priceBox" style="background:var(--bg-secondary,#f7f7f7); border-radius:8px; padding:12px 16px; display:none;">
                <strong>Estimated Price: <span id="priceDisplay"></span></strong>
              </div>
              <div class="form-group">
                <label>Coupon Code (optional)</label>
                <div style="display:flex; gap:8px;">
                  <input type="text" id="couponInput" placeholder="Enter coupon code" style="flex:1;">
                  <button type="button" class="btn btn-outline" id="applyCouponBtn">Apply</button>
                </div>
                <small id="couponMessage" style="display:block; margin-top:6px;"></small>
              </div>
              <input type="hidden" name="coupon_code" id="couponCodeInput">
              <% if (typeof isCustomer !== 'undefined' && isCustomer && typeof walletBalance !== 'undefined' && walletBalance > 0) { %>
              <div class="form-group" style="background:#eefaf1; border:1px solid #bfe8cc; border-radius:8px; padding:12px 16px;">
                <label style="display:flex; align-items:center; gap:8px; font-weight:normal; cursor:pointer;">
                  <input type="checkbox" name="use_wallet" value="1" style="width:auto;">
                  Use my wallet balance (₹<%= walletBalance %> available)
                </label>
                <small style="color:var(--text-secondary,#777);">The exact amount applied is shown on your order confirmation — it can't exceed your order total.</small>
              </div>
              <% } %>
              <div class="form-group" id="customNote" style="background:#fff2cc; border:1px solid #e6cf87; border-radius:8px; padding:12px 16px; display:none;">
                Picked Custom? Tell us the size or idea in the notes below — we'll confirm the price with you before your order is final.
              </div>
              <input type="hidden" name="estimated_price" id="estimatedPriceInput">
              <input type="hidden" name="discount_percent_applied" id="discountAppliedInput">
              <input type="hidden" name="preset_price" id="presetPriceInput" value="<%= typeof presetPrice !== 'undefined' ? presetPrice : '' %>">
              <input type="hidden" name="compressed_image_data" id="compressedImageData">
              <div class="wizard-nav">
                <span></span>
                <button type="button" class="btn btn-primary wizard-next" data-next="2">Next: Add Photo →</button>
              </div>
            </div>

            <!-- STEP 2: Upload photo -->
            <div class="wizard-panel" data-panel="2">
              <div class="form-group">
                <label>Upload Reference Photo</label>
                <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Upload a reference photo">
                  <div class="dropzone-empty" id="dropzoneEmpty">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
                    <p><strong>Tap to choose a photo</strong><br>or drag one here</p>
                    <span>JPG or PNG, up to 15MB — we'll optimize it automatically</span>
                  </div>
                  <div class="dropzone-filled" id="dropzoneFilled" style="display:none;">
                    <img id="previewImg" alt="Your uploaded photo">
                    <div class="dropzone-file-info">
                      <span id="fileNameLabel"></span>
                      <button type="button" class="btn btn-outline btn-sm" id="changePhotoBtn">Change Photo</button>
                    </div>
                  </div>
                  <div class="dropzone-loading" id="dropzoneLoading" style="display:none;">
                    <span class="spinner-small"></span> Optimizing photo for a fast upload…
                  </div>
                </div>
                <input type="file" name="reference_image" accept="image/*" id="refImageInput" style="display:none;">
                <small class="quality-msg" id="qualityMsg" style="display:none;"></small>
                <small class="upload-error" id="uploadError" style="display:none; color:#a2231d;"></small>
              </div>
              <div class="form-group"><label>Notes / Special Instructions</label><textarea name="notes"><%= old.notes || '' %></textarea></div>
              <div class="wizard-nav">
                <button type="button" class="btn btn-outline wizard-back" data-back="1">← Back</button>
                <button type="button" class="btn btn-primary wizard-next" data-next="3">Next: Delivery →</button>
              </div>
            </div>

            <!-- STEP 3: Delivery details -->
            <div class="wizard-panel" data-panel="3">
              <div class="form-group"><label>Delivery Address</label>
                <input type="text" name="address_line" placeholder="House / Street / Area" value="<%= old.address_line || '' %>" required>
              </div>
              <div class="form-row">
                <div class="form-group"><label>City</label><input type="text" name="city" value="<%= old.city || '' %>" required></div>
                <div class="form-group"><label>State</label><input type="text" name="state" value="<%= old.state || '' %>" required></div>
              </div>
              <div class="form-group"><label>Pincode</label>
                <input type="text" name="pincode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" value="<%= old.pincode || '' %>" required>
              </div>
              <div class="form-group">
                <label>Preferred Delivery Date</label>
                <input type="date" name="delivery_date" id="deliveryDate" value="<%= old.delivery_date || '' %>">
                <small id="dateWarning" style="color:#a2231d; display:none;">That date isn't available — please pick another.</small>
              </div>
              <div class="wizard-nav">
                <button type="button" class="btn btn-outline wizard-back" data-back="2">← Back</button>
                <button class="btn btn-gold" type="button" id="reviewOrderBtn">Review Order →</button>
              </div>
            </div>

          </div>

          <!-- STEP 4: Review -->
          <div id="orderPreview" class="wizard-panel" data-panel="4" style="display:none;">
            <h3 style="margin-top:0;">Review Your Order</h3>
            <p style="color:var(--text-secondary,#777); font-size:0.9rem;">Please check everything below before confirming.</p>
            <div style="background:var(--bg-secondary,#f7f7f7); border-radius:8px; padding:16px; margin-bottom:16px;">
              <img id="pv_photo" style="display:none; max-width:160px; border-radius:8px; margin-bottom:12px;">
              <table style="width:100%; border-collapse:collapse; font-size:0.92rem;">
                <tr><td style="padding:6px 0; color:var(--text-secondary,#777); width:40%;">Name</td><td id="pv_name" style="padding:6px 0;"></td></tr>
                <tr><td style="padding:6px 0; color:var(--text-secondary,#777);">Phone</td><td id="pv_phone" style="padding:6px 0;"></td></tr>
                <tr><td style="padding:6px 0; color:var(--text-secondary,#777);">Email</td><td id="pv_email" style="padding:6px 0;"></td></tr>
                <tr><td style="padding:6px 0; color:var(--text-secondary,#777);">Art Type / Size</td><td id="pv_art" style="padding:6px 0;"></td></tr>
                <tr><td style="padding:6px 0; color:var(--text-secondary,#777);">Estimated Price</td><td id="pv_price" style="padding:6px 0;"></td></tr>
                <tr id="pv_coupon_row" style="display:none;"><td style="padding:6px 0; color:var(--text-secondary,#777);">Coupon</td><td id="pv_coupon" style="padding:6px 0;"></td></tr>
                <tr><td style="padding:6px 0; color:var(--text-secondary,#777);">Delivery Address</td><td id="pv_address" style="padding:6px 0;"></td></tr>
                <tr><td style="padding:6px 0; color:var(--text-secondary,#777);">Delivery Date</td><td id="pv_date" style="padding:6px 0;"></td></tr>
                <tr id="pv_notes_row" style="display:none;"><td style="padding:6px 0; color:var(--text-secondary,#777); vertical-align:top;">Notes</td><td id="pv_notes" style="padding:6px 0;"></td></tr>
              </table>
            </div>
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
              <button class="btn btn-outline" type="button" id="editOrderBtn">← Edit Details</button>
              <button class="btn btn-gold" type="submit" id="confirmOrderBtn">Confirm &amp; Place Order</button>
            </div>
          </div>
        </form>

        <div class="mobile-order-bar" id="mobileOrderBar">
          <div class="mobile-order-price" id="mobileOrderPrice">Choose your art &amp; size to see the price</div>
          <button type="button" class="btn btn-gold" id="mobileOrderBtn">Next</button>
        </div>
      <% } %>
    </div>
  </div>
</section>

<div class="submit-overlay" id="submitOverlay">
  <div class="submit-overlay-box">
    <span class="spinner-ring"></span>
    <p>Uploading your photo and placing your order…</p>
    <small>Please don't close this page</small>
  </div>
</div>

<script>
  <% if (success) { %>
  try { sessionStorage.removeItem('kka_order_draft'); } catch (e) {}
  <% } %>
  const servicesData = <%- JSON.stringify(services || []) %>;
  const offerDiscount = <%- offerDiscount || 0 %>;
  const artTypeSelect = document.getElementById('artTypeSelect');
  const sizeSelect = document.getElementById('sizeSelect');
  const priceBox = document.getElementById('priceBox');
  const priceDisplay = document.getElementById('priceDisplay');
  const customNote = document.getElementById('customNote');
  const estimatedPriceInput = document.getElementById('estimatedPriceInput');
  const discountAppliedInput = document.getElementById('discountAppliedInput');
  const couponInput = document.getElementById('couponInput');
  const applyCouponBtn = document.getElementById('applyCouponBtn');
  const couponMessage = document.getElementById('couponMessage');
  const couponCodeInput = document.getElementById('couponCodeInput');
  let couponDiscount = 0;

  function legacyPriceKey(size) {
    const s = String(size || '').toLowerCase();
    if (s === 'a5') return 'price_a5';
    if (s === 'a4') return 'price_a4';
    if (s === 'a3') return 'price_a3';
    if (s === 'a2') return 'price_a2';
    if (s === 'custom') return 'price_custom';
    return null;
  }

  function priceForSize(service, size) {
    if (!service) return '';
    if (service.prices && service.prices[size]) return service.prices[size];
    const lk = legacyPriceKey(size);
    if (lk && service[lk]) return service[lk];
    return '';
  }

  const presetPrice = <%- JSON.stringify(typeof presetPrice !== 'undefined' ? presetPrice : '') %>;

  function getBasePrice() {
    if (presetPrice) {
      const p = parseFloat(String(presetPrice).replace(/[^0-9.]/g, ''));
      if (p) return p;
    }
    const service = servicesData.find(s => s.title === artTypeSelect.value);
    const rawPrice = priceForSize(service, sizeSelect.value);
    return parseFloat(String(rawPrice || '').replace(/[^0-9.]/g, ''));
  }

  function updatePrice() {
    if (sizeSelect.value.toLowerCase() === 'custom') {
      priceBox.style.display = 'none';
      customNote.style.display = 'block';
      estimatedPriceInput.value = '';
      discountAppliedInput.value = '';
      return;
    }
    customNote.style.display = 'none';
    const numericPrice = getBasePrice();
    if (!numericPrice) { priceBox.style.display = 'none'; estimatedPriceInput.value = ''; discountAppliedInput.value = ''; return; }
    // A coupon the customer actively typed in and applied should always be
    // the one that visibly changes the price — silently keeping a bigger
    // site-wide offer instead (old Math.max behaviour) made it look like
    // the coupon code did nothing.
    const bestDiscount = couponDiscount || offerDiscount;
    const discounted = bestDiscount ? numericPrice - (numericPrice * bestDiscount / 100) : numericPrice;
    priceDisplay.textContent = bestDiscount
      ? `₹${discounted.toFixed(0)} (was ₹${numericPrice.toFixed(0)}, ${bestDiscount}% off)`
      : `₹${numericPrice.toFixed(0)}`;
    priceBox.style.display = 'block';
    estimatedPriceInput.value = discounted.toFixed(0);
    discountAppliedInput.value = bestDiscount;
  }
  if (artTypeSelect) {
    artTypeSelect.addEventListener('change', function () { updatePrice(); syncMobileBar(); });
    sizeSelect.addEventListener('change', function () { updatePrice(); syncMobileBar(); });
    updatePrice();
  }

  // ---- Phone number: digits only, max 10 ----
  const phoneInput = document.getElementById('phoneInput');
  if (phoneInput) phoneInput.addEventListener('input', function () {
    phoneInput.value = phoneInput.value.replace(/\D/g, '').slice(0, 10);
  });

  if (applyCouponBtn) applyCouponBtn.addEventListener('click', async function () {
    const code = couponInput.value.trim();
    if (!code) return;
    couponMessage.textContent = 'Checking...';
    couponMessage.style.color = 'var(--text-secondary,#777)';
    try {
      const res = await fetch('/coupon/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code })
      });
      const data = await res.json();
      if (data.valid) {
        couponDiscount = data.discount_percent;
        couponCodeInput.value = code;
        couponMessage.textContent = data.message;
        couponMessage.style.color = '#1a7a3f';
      } else {
        couponDiscount = 0;
        couponCodeInput.value = '';
        couponMessage.textContent = data.message;
        couponMessage.style.color = '#a2231d';
      }
      updatePrice();
    } catch (e) {
      couponMessage.textContent = 'Could not check that coupon — please try again.';
      couponMessage.style.color = '#a2231d';
    }
  });

  const blockedDates = <%- JSON.stringify(blockedDates || []) %>;
  const dateInput = document.getElementById('deliveryDate');
  const warning = document.getElementById('dateWarning');
  const submitBtn = document.getElementById('reviewOrderBtn');
  if (dateInput) {
    dateInput.addEventListener('change', function () {
      if (blockedDates.includes(dateInput.value)) {
        warning.style.display = 'block';
        submitBtn.disabled = true;
      } else {
        warning.style.display = 'none';
        submitBtn.disabled = false;
      }
    });
  }

  // ---- Wizard step navigation ----
  const panels = document.querySelectorAll('.wizard-panel');
  const dots = document.querySelectorAll('.wizard-step-dot');
  const mobileOrderBar = document.getElementById('mobileOrderBar');
  const mobileOrderBtn = document.getElementById('mobileOrderBtn');
  const mobileOrderPrice = document.getElementById('mobileOrderPrice');
  const wizardEtaStep = document.getElementById('wizardEtaStep');

  function syncMobileBar(step) {
    if (!mobileOrderBar) return;
    const currentStep = step || parseInt(document.querySelector('.wizard-panel.active')?.dataset.panel || '1', 10);
    if (currentStep === 4) mobileOrderBtn.textContent = 'Confirm & Place Order';
    else if (currentStep === 3) mobileOrderBtn.textContent = 'Review Order →';
    else mobileOrderBtn.textContent = 'Next →';
    mobileOrderPrice.textContent = (priceDisplay && priceDisplay.textContent)
      ? 'Est. ' + priceDisplay.textContent
      : 'Choose your art & size to see the price';
  }

  function goToStep(n) {
    panels.forEach(p => p.classList.toggle('active', p.dataset.panel === String(n)));
    dots.forEach(d => {
      const step = parseInt(d.dataset.step, 10);
      d.classList.toggle('active', step === n);
      d.classList.toggle('done', step < n);
    });
    if (wizardEtaStep) wizardEtaStep.textContent = n;
    syncMobileBar(n);
    document.querySelector('.wizard-box').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  if (mobileOrderBtn) mobileOrderBtn.addEventListener('click', function () {
    const activePanel = document.querySelector('.wizard-panel.active');
    if (!activePanel) return;
    if (activePanel.dataset.panel === '4') { document.getElementById('confirmOrderBtn').click(); return; }
    if (activePanel.dataset.panel === '3') { reviewOrderBtn.click(); return; }
    const nextBtn = activePanel.querySelector('.wizard-next');
    if (nextBtn) nextBtn.click();
  });
  syncMobileBar(1);
  document.querySelectorAll('.wizard-next').forEach(btn => {
    btn.addEventListener('click', function () {
      const panel = btn.closest('.wizard-panel');
      const requiredFields = panel.querySelectorAll('[required]');
      for (const f of requiredFields) { if (!f.reportValidity()) return; }
      goToStep(parseInt(btn.dataset.next, 10));
    });
  });
  document.querySelectorAll('.wizard-back').forEach(btn => {
    btn.addEventListener('click', function () { goToStep(parseInt(btn.dataset.back, 10)); });
  });

  // ---- Step 2: Photo upload — drag & drop, compression, quality check ----
  const refImageInput = document.getElementById('refImageInput');
  const dropzone = document.getElementById('dropzone');
  const dropzoneEmpty = document.getElementById('dropzoneEmpty');
  const dropzoneFilled = document.getElementById('dropzoneFilled');
  const dropzoneLoading = document.getElementById('dropzoneLoading');
  const previewImg = document.getElementById('previewImg');
  const fileNameLabel = document.getElementById('fileNameLabel');
  const changePhotoBtn = document.getElementById('changePhotoBtn');
  const qualityMsg = document.getElementById('qualityMsg');
  const uploadError = document.getElementById('uploadError');

  function showUploadError(msg) {
    uploadError.textContent = msg;
    uploadError.style.display = 'block';
  }
  function clearUploadError() { uploadError.style.display = 'none'; }

  // Blur detector: downscales the photo to a small fixed size and runs the
  // classic "variance of Laplacian" edge-detection heuristic — sharp photos
  // have lots of strong, varied edges (high variance); blurry photos have
  // smooth, muted transitions (low variance). This is a plain client-side
  // computation (no AI service, no upload needed), so it runs instantly and
  // for free before the customer even submits the order.
  function computeSharpness(img, w, h) {
    const size = 240;
    const scale = size / Math.max(w, h);
    const sw = Math.max(1, Math.round(w * scale));
    const sh = Math.max(1, Math.round(h * scale));
    const canvas = document.createElement('canvas');
    canvas.width = sw; canvas.height = sh;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, sw, sh);
    const { data } = ctx.getImageData(0, 0, sw, sh);

    const gray = new Float32Array(sw * sh);
    for (let i = 0, p = 0; i < data.length; i += 4, p++) {
      gray[p] = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
    }

    let sum = 0, sumSq = 0, count = 0;
    for (let y = 1; y < sh - 1; y++) {
      for (let x = 1; x < sw - 1; x++) {
        const idx = y * sw + x;
        const lap = -4 * gray[idx] + gray[idx - 1] + gray[idx + 1] + gray[idx - sw] + gray[idx + sw];
        sum += lap;
        sumSq += lap * lap;
        count++;
      }
    }
    if (!count) return null;
    const mean = sum / count;
    return (sumSq / count) - (mean * mean); // variance of the Laplacian
  }

  // Resize/re-compress large phone photos in the browser before upload —
  // most camera photos are 4-12MB; this gets them down to a fraction of that
  // with no visible quality loss, which matters a lot on slower mobile data.
  function loadImageEl(file) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => resolve({ img, url });
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('load-failed')); };
      img.src = url;
    });
  }

  async function compressImage(file, maxDim, quality) {
    try {
      const { img, url } = await loadImageEl(file);
      const w = img.naturalWidth, h = img.naturalHeight;
      // Measure sharpness on the original photo, before any resizing or
      // re-compression softens it.
      const sharpness = computeSharpness(img, w, h);
      // Skip re-encoding if it's already small — no point spending CPU.
      if (file.size < 600 * 1024 && Math.max(w, h) <= maxDim) {
        URL.revokeObjectURL(url);
        return { file, width: w, height: h, sharpness };
      }
      let targetW = w, targetH = h;
      if (Math.max(w, h) > maxDim) {
        const scale = maxDim / Math.max(w, h);
        targetW = Math.round(w * scale);
        targetH = Math.round(h * scale);
      }
      const canvas = document.createElement('canvas');
      canvas.width = targetW; canvas.height = targetH;
      canvas.getContext('2d').drawImage(img, 0, 0, targetW, targetH);
      URL.revokeObjectURL(url);
      const blob = await new Promise(res => canvas.toBlob(res, 'image/jpeg', quality));
      if (!blob || blob.size >= file.size) return { file, width: w, height: h, sharpness };
      const newName = file.name.replace(/\.[^.]+$/, '') + '.jpg';
      return { file: new File([blob], newName, { type: 'image/jpeg' }), width: w, height: h, sharpness };
    } catch (e) {
      return { file, width: null, height: null, sharpness: null };
    }
  }

  function setInputFile(file) {
    try {
      const dt = new DataTransfer();
      dt.items.add(file);
      refImageInput.files = dt.files;
      return true;
    } catch (e) {
      return false; // very old browser — original selection (if any) stays as-is
    }
  }

  // Threshold picked from typical phone-camera photos at the 240px
  // measurement size used above. If you notice it flagging clearly sharp
  // photos as blurry (or missing obviously blurry ones) once real customer
  // photos start coming through, adjust this number — lower = more lenient.
  const BLUR_THRESHOLD = 150;

  function checkQuality(w, h, sharpness) {
    if (!w || !h) { qualityMsg.style.display = 'none'; return; }
    const shortSide = Math.min(w, h);
    const lowRes = shortSide < 700;
    const blurry = sharpness !== null && sharpness !== undefined && sharpness < BLUR_THRESHOLD;

    if (blurry && lowRes) {
      qualityMsg.textContent = "This photo looks a little blurry and is low resolution — for the best portrait, a sharper, clearer photo works best if you have one. You can still continue.";
      qualityMsg.style.color = '#a2231d';
    } else if (blurry) {
      qualityMsg.textContent = 'This photo looks a little blurry — a steady, well-lit photo will give the sharpest result. You can still continue.';
      qualityMsg.style.color = '#a2231d';
    } else if (lowRes) {
      qualityMsg.textContent = "This photo's resolution is a bit low — for the sharpest large portrait, a clearer photo works best. You can still continue.";
      qualityMsg.style.color = '#a2691d';
    } else {
      qualityMsg.textContent = 'This photo looks sharp and clear — great for a detailed portrait.';
      qualityMsg.style.color = '#1a7a3f';
    }
    qualityMsg.style.display = 'block';
  }

  const compressedImageDataInput = document.getElementById('compressedImageData');

  function fileToDataUrl(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => reject(new Error('read-failed'));
      reader.readAsDataURL(file);
    });
  }

  async function handleFile(rawFile) {
    clearUploadError();
    if (!rawFile) return;
    if (!rawFile.type.startsWith('image/')) {
      showUploadError('Please choose an image file (JPG or PNG).');
      return;
    }
    if (rawFile.size > 15 * 1024 * 1024) {
      showUploadError('That photo is larger than 15MB. Please choose a smaller one.');
      return;
    }
    dropzoneEmpty.style.display = 'none';
    dropzoneFilled.style.display = 'none';
    dropzoneLoading.style.display = 'flex';

    const { file, width, height, sharpness } = await compressImage(rawFile, 1900, 0.82);
    setInputFile(file);

    // Also stash the compressed photo as base64 in a hidden field. Some
    // Android Chrome versions fail to actually upload the <input type=file>
    // handle at submit time (ERR_UPLOAD_FILE_CHANGED) — this hidden copy is
    // plain in-memory data, so the order never silently fails because of it.
    try {
      compressedImageDataInput.value = await fileToDataUrl(file);
    } catch (e) {
      compressedImageDataInput.value = ''; // fall back to the file input alone
    }

    dropzoneLoading.style.display = 'none';
    dropzoneFilled.style.display = 'flex';
    previewImg.src = URL.createObjectURL(file);
    fileNameLabel.textContent = rawFile.name + (file.size < rawFile.size ? ' · optimized for upload' : '');
    checkQuality(width, height, sharpness);
  }

  if (dropzone) {
    dropzone.addEventListener('click', () => refImageInput.click());
    dropzone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); refImageInput.click(); } });
    ['dragover', 'dragenter'].forEach(evt => dropzone.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.add('dragover'); }));
    ['dragleave', 'dragend'].forEach(evt => dropzone.addEventListener(evt, () => dropzone.classList.remove('dragover')));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });
  }
  if (refImageInput) refImageInput.addEventListener('change', function () {
    if (refImageInput.files && refImageInput.files[0]) handleFile(refImageInput.files[0]);
  });
  if (changePhotoBtn) changePhotoBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    refImageInput.value = '';
    compressedImageDataInput.value = '';
    dropzoneFilled.style.display = 'none';
    qualityMsg.style.display = 'none';
    dropzoneEmpty.style.display = 'flex';
  });

  // ---- Review Order step ----
  const orderForm = document.getElementById('orderForm');
  const orderFields = document.getElementById('orderFields');
  const orderPreview = document.getElementById('orderPreview');
  const reviewOrderBtn = document.getElementById('reviewOrderBtn');
  const editOrderBtn = document.getElementById('editOrderBtn');

  if (reviewOrderBtn) reviewOrderBtn.addEventListener('click', function () {
    if (!orderForm.reportValidity()) return;

    document.getElementById('pv_name').textContent = orderForm.name.value;
    document.getElementById('pv_phone').textContent = orderForm.phone.value;
    document.getElementById('pv_email').textContent = orderForm.email.value || '—';
    document.getElementById('pv_art').textContent = artTypeSelect.value + ' / ' + sizeSelect.value;
    document.getElementById('pv_price').textContent = priceDisplay.textContent || 'To be confirmed';

    const couponRow = document.getElementById('pv_coupon_row');
    if (couponCodeInput.value) {
      couponRow.style.display = '';
      document.getElementById('pv_coupon').textContent = couponCodeInput.value + ' (' + couponDiscount + '% off)';
    } else {
      couponRow.style.display = 'none';
    }

    const addressParts = [orderForm.address_line.value, orderForm.city.value, orderForm.state.value, orderForm.pincode.value].filter(Boolean);
    document.getElementById('pv_address').textContent = addressParts.join(', ');
    document.getElementById('pv_date').textContent = dateInput.value || 'Not specified';

    const notesRow = document.getElementById('pv_notes_row');
    if (orderForm.notes.value.trim()) {
      notesRow.style.display = '';
      document.getElementById('pv_notes').textContent = orderForm.notes.value;
    } else {
      notesRow.style.display = 'none';
    }

    const pvPhoto = document.getElementById('pv_photo');
    const fileInput = orderForm.querySelector('input[name="reference_image"]');
    if (fileInput.files && fileInput.files[0]) {
      const reader = new FileReader();
      reader.onload = function (e) { pvPhoto.src = e.target.result; pvPhoto.style.display = 'block'; };
      reader.readAsDataURL(fileInput.files[0]);
    } else {
      pvPhoto.style.display = 'none';
    }

    orderFields.style.display = 'none';
    orderPreview.style.display = 'block';
    goToStep(4);
  });

  if (editOrderBtn) editOrderBtn.addEventListener('click', function () {
    orderPreview.style.display = 'none';
    orderFields.style.display = 'block';
    goToStep(3);
  });

  // ---- Submit: show a "please wait" overlay and stop double-submits ----
  const submitOverlay = document.getElementById('submitOverlay');
  const confirmOrderBtn = document.getElementById('confirmOrderBtn');
  if (orderForm) orderForm.addEventListener('submit', function () {
    if (confirmOrderBtn) { confirmOrderBtn.disabled = true; confirmOrderBtn.textContent = 'Placing your order…'; }
    if (submitOverlay) submitOverlay.classList.add('active');
    try { sessionStorage.removeItem('kka_order_draft'); } catch (e) {}
  });

  // ---- Autosave text fields to sessionStorage so an accidental refresh or
  // back/forward navigation doesn't lose what the customer already typed.
  // The uploaded photo itself is never persisted this way (can't be, and
  // shouldn't be — it stays only in the live file input).
  if (orderForm) {
    const AUTOSAVE_KEY = 'kka_order_draft';
    const autosaveFields = orderForm.querySelectorAll('input[type="text"], input[type="tel"], input[type="email"], input[type="date"], select, textarea');
    function saveDraft() {
      const data = {};
      autosaveFields.forEach(f => { if (f.name) data[f.name] = f.value; });
      try { sessionStorage.setItem(AUTOSAVE_KEY, JSON.stringify(data)); } catch (e) {}
    }
    autosaveFields.forEach(f => {
      f.addEventListener('input', saveDraft);
      f.addEventListener('change', saveDraft);
    });

    const hadOldValues = <%- JSON.stringify(!!(old && Object.keys(old).length)) %>;
    if (!hadOldValues) {
      try {
        const raw = sessionStorage.getItem(AUTOSAVE_KEY);
        if (raw) {
          const data = JSON.parse(raw);
          Object.keys(data).forEach(k => {
            const f = orderForm.elements[k];
            if (f && !f.value && data[k]) f.value = data[k];
          });
          updatePrice();
        }
      } catch (e) {}
    }
  }
</script>

<%- include('partials/footer') %>
