<% pageTitle = 'Customer Gallery' %>
<% pageDescription = `Real photos from real customers — see how a ${settings.site_name} portrait looks framed and hung in their homes.` %>
<%- include('partials/header') %>

<div class="container" style="padding-top:18px;">
  <% crumbs = [{ name: 'Home', url: '/' }, { name: 'Gallery' }]; %>
  <%- include('partials/breadcrumbs') %>
</div>

<section class="section" style="padding-top:0;">
  <div class="container">
    <h1>Gallery</h1>
    <p class="sub">Real portraits, in real homes — shared by the people who ordered them.</p>

    <% if (submitted) { %>
      <div class="alert alert-success" style="margin-bottom:20px;">Thank you! Your photo has been submitted and will appear here once approved.</div>
    <% } %>
    <% if (typeof submitError !== 'undefined' && submitError) { %>
      <div class="alert alert-error" style="margin-bottom:20px;"><%= submitError %></div>
    <% } %>

    <% if (photos.length) { %>
      <div class="gallery-grid">
        <% photos.forEach(p => { %>
          <button type="button" class="gallery-item" data-full="<%= p.photo_url %>" data-caption="<%= (p.caption || '').replace(/"/g, '&quot;') %>" data-name="<%= p.name %>">
            <img src="<%= p.photo_url %>" alt="Photo shared by <%= p.name %>" loading="lazy" decoding="async">
            <span class="gallery-item-name"><%= p.name %></span>
          </button>
        <% }) %>
      </div>
    <% } else { %>
      <p class="sub">No photos yet — be the first to share yours below!</p>
    <% } %>
  </div>
</section>

<section class="section section-tint">
  <div class="container" style="max-width:520px;">
    <h3>Share Your Photo</h3>
    <p class="sub">Got your portrait framed and hung up? We'd love to see it — and so would future customers.</p>
    <form class="admin-form" action="/gallery/submit" method="POST" enctype="multipart/form-data">
      <input type="text" name="website" style="position:absolute; left:-9999px;" tabindex="-1" autocomplete="off">
      <div class="form-group"><label>Your Name</label><input type="text" name="name" placeholder="e.g. Priya S." <% if (isCustomer && typeof customerName !== 'undefined') { %>value="<%= customerName %>"<% } %>></div>
      <div class="form-group"><label>Caption (optional)</label><input type="text" name="caption" placeholder="e.g. Looks amazing on our living room wall!"></div>
      <div class="form-group"><label>Photo</label><input type="file" name="photo" accept="image/*" required></div>
      <button class="btn btn-primary" type="submit">Submit Photo</button>
    </form>
  </div>
</section>

<div class="gallery-lightbox" id="galleryLightbox" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:999; align-items:center; justify-content:center; padding:20px;">
  <button type="button" id="galleryLightboxClose" aria-label="Close" style="position:absolute; top:20px; right:20px; background:none; border:none; color:#fff; font-size:2rem; cursor:pointer; line-height:1;">&times;</button>
  <div style="max-width:600px; text-align:center;">
    <img id="galleryLightboxImg" src="" alt="" style="max-width:100%; max-height:75vh; border-radius:8px; object-fit:contain;">
    <p id="galleryLightboxCaption" style="color:#fff; margin-top:14px;"></p>
  </div>
</div>

<style>
  .gallery-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:16px; margin-top:24px; }
  .gallery-item { position:relative; padding:0; border:none; border-radius:10px; overflow:hidden; cursor:pointer; background:none; aspect-ratio:1; }
  .gallery-item img { width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.25s ease; }
  .gallery-item:hover img { transform:scale(1.05); }
  .gallery-item-name { position:absolute; bottom:0; left:0; right:0; padding:8px 10px; background:linear-gradient(transparent, rgba(0,0,0,0.7)); color:#fff; font-size:0.8rem; text-align:left; }
</style>

<script>
  (function () {
    var lightbox = document.getElementById('galleryLightbox');
    var img = document.getElementById('galleryLightboxImg');
    var caption = document.getElementById('galleryLightboxCaption');
    document.querySelectorAll('.gallery-item').forEach(function (btn) {
      btn.addEventListener('click', function () {
        img.src = btn.getAttribute('data-full');
        var cap = btn.getAttribute('data-caption') || '';
        var name = btn.getAttribute('data-name') || '';
        caption.textContent = cap ? (cap + ' — ' + name) : name;
        lightbox.style.display = 'flex';
      });
    });
    document.getElementById('galleryLightboxClose').addEventListener('click', function () {
      lightbox.style.display = 'none';
      img.src = '';
    });
    lightbox.addEventListener('click', function (e) {
      if (e.target === lightbox) { lightbox.style.display = 'none'; img.src = ''; }
    });
  })();
</script>

<%- include('partials/footer') %>
