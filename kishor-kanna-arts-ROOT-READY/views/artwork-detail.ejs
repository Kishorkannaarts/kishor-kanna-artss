<% pageTitle = artwork.title %>
<% pageDescription = (artwork.description || `${artwork.title} — a hand-made ${artwork.category || 'custom'} portrait${artwork.size ? ' in ' + artwork.size : ''}.`).slice(0, 160) %>
<% pageImage = artwork.image %>
<%- include('partials/header') %>
<div class="container">
  <% crumbs = [{ name: 'Home', url: '/' }, { name: 'Portfolio', url: '/portfolio' }, { name: artwork.title }] %>
  <%- include('partials/breadcrumbs') %>
</div>

<section class="section">
  <div class="container" style="max-width:900px;">
    <div class="grid artwork-detail-grid">
      <img src="<%= artwork.image || 'https://placehold.co/500x500?text=Artwork' %>" alt="<%= artwork.title %>" loading="lazy" decoding="async" style="border-radius:14px; width:100%;">
      <div>
        <span class="tag"><%= artwork.category %></span>
        <h1><%= artwork.title %></h1>
        <p><%= artwork.description %></p>
        <% if (artwork.story) { %><p style="color:var(--text-secondary); font-style:italic;"><%= artwork.story %></p><% } %>
        <p><strong>Size:</strong> <%= artwork.size || '—' %></p>
        <% if (artwork.price) { %><p><strong>Price:</strong> <%= artwork.price %></p><% } %>
        <a class="btn btn-gold" href="/order?art_type=<%= encodeURIComponent(artwork.category) %>&size=<%= encodeURIComponent(artwork.size || '') %>&price=<%= encodeURIComponent(artwork.price || '') %>">Order Similar Artwork</a>
      </div>
    </div>
  </div>
</section>

<% if (related && related.length) { %>
<section class="section" style="padding-top:0;">
  <div class="container">
    <h2 class="reveal">You Might Also Like</h2>
    <div class="grid grid-2 grid-arts">
      <% related.forEach(a => { %>
        <div class="card reveal">
          <a href="/portfolio/<%= a.id %>">
            <img src="<%= a.image || 'https://placehold.co/400x300?text=Artwork' %>" alt="<%= a.title %>" loading="lazy" decoding="async">
          </a>
          <div class="card-body">
            <span class="tag"><%= a.category %></span>
            <h3><a href="/portfolio/<%= a.id %>" style="color:inherit; text-decoration:none;"><%= a.title %></a></h3>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": artwork.title,
  "description": artwork.description || undefined,
  "image": artwork.image || undefined,
  "category": artwork.category || undefined,
  "offers": artwork.price ? {
    "@type": "Offer",
    "priceCurrency": "INR",
    "price": String(artwork.price).replace(/[^0-9.]/g, ''),
    "availability": "https://schema.org/InStock",
    "url": siteUrl + currentPath
  } : undefined
}) %>
</script>

<%- include('partials/footer') %>
