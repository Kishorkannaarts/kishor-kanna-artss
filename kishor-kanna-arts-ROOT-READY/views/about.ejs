<% pageTitle = settings.seo_about_title || 'About Us' %>
<% pageDescription = settings.seo_about_description || `Meet the artist behind ${settings.site_name}. Real customer reviews, FAQs, and answers before you place a custom portrait order.` %>
<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <div class="about-hero">
      <% if (settings.about_image_url) { %>
        <img src="<%= settings.about_image_url %>" alt="<%= settings.site_name %>" class="about-hero-img" loading="lazy" decoding="async">
      <% } %>
      <div>
        <h1>About <%= settings.site_name %></h1>
        <p><%= settings.about_text %></p>
        <div class="about-stats">
          <% if (settings.about_years_experience) { %><div class="about-stat"><strong><%= settings.about_years_experience %>+</strong><span>Years Experience</span></div><% } %>
          <div class="about-stat"><strong>1000+</strong><span>Portraits Completed</span></div>
          <div class="about-stat"><strong>500+</strong><span>Happy Customers</span></div>
          <div class="about-stat"><strong>100%</strong><span>Handmade</span></div>
        </div>
      </div>
    </div>

    <div class="grid grid-2" style="margin-top:40px; gap:24px;">
      <div class="card" style="padding:24px;">
        <h3 style="margin-top:0; font-family:var(--font-display);">Our Mission</h3>
        <p style="color:var(--text-secondary);"><%= settings.about_mission || "To transform people's most meaningful memories into handcrafted artworks that last forever." %></p>
      </div>
      <div class="card" style="padding:24px;">
        <h3 style="margin-top:0; font-family:var(--font-display);">Our Vision</h3>
        <p style="color:var(--text-secondary);"><%= settings.about_vision || "To be the studio people trust with their most cherished memories — known not just for skilled portraits, but for the care taken with every single one." %></p>
      </div>
    </div>
  </div>
</section>

<% if (timeline && timeline.length) { %>
<section class="section section-tint">
  <div class="container" style="max-width:700px;">
    <h2>Our Journey</h2>
    <div class="about-timeline" style="margin-top:24px; display:flex; flex-direction:column; gap:20px;">
      <% timeline.forEach(t => { %>
        <div style="display:flex; gap:16px; align-items:flex-start;">
          <strong style="min-width:90px; color:var(--gold);"><%= t.year_label %></strong>
          <p style="margin:0;"><%= t.text %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <h2>Our Creative Process</h2>
    <p class="sub">From your photo to a finished artwork — every order follows the same careful process</p>
    <div class="grid grid-4" style="margin-top:24px;">
      <% ['Order Received','Sketch Started','Customer Approval','Artwork Creation','Framing','Packaging','Shipping','Delivered'].forEach((step, i) => { %>
        <div class="card" style="padding:18px; text-align:center;">
          <div style="width:36px; height:36px; border-radius:50%; background:var(--gold); color:#221a10; display:flex; align-items:center; justify-content:center; font-weight:700; margin:0 auto 10px;"><%= i + 1 %></div>
          <p style="margin:0; font-weight:600; font-size:0.92rem;"><%= step %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<% if (studioPhotos && studioPhotos.length) { %>
<section class="section section-tint">
  <div class="container">
    <h2>Behind the Scenes</h2>
    <p class="sub">A look inside our studio</p>
    <div class="grid grid-4" style="margin-top:20px;">
      <% studioPhotos.forEach(p => { %>
        <img src="<%= p.image_url %>" alt="<%= p.caption || 'Studio photo' %>" loading="lazy" decoding="async" style="width:100%; aspect-ratio:1; object-fit:cover; border-radius:10px;">
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (videos && videos.length) { %>
<section class="section">
  <div class="container">
    <h2>Watch Us Work</h2>
    <div class="grid grid-3" style="margin-top:20px;">
      <% videos.forEach(v => { %>
        <div class="video-card">
          <div style="aspect-ratio:16/9; border-radius:10px; overflow:hidden;">
            <iframe src="<%= v.embed_url %>" title="<%= v.title %>" loading="lazy" frameborder="0" allowfullscreen style="width:100%; height:100%;"></iframe>
          </div>
          <p style="margin-top:8px; font-weight:600; font-size:0.9rem;"><%= v.title %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (awards && awards.length) { %>
<section class="section section-tint">
  <div class="container" style="max-width:700px;">
    <h2>Awards &amp; Recognition</h2>
    <div class="grid grid-2" style="margin-top:20px; gap:16px;">
      <% awards.forEach(a => { %>
        <div class="card" style="padding:18px;">
          <p style="margin:0; font-weight:600;"><%= a.title %></p>
          <p class="sub" style="margin:4px 0 0;"><%= [a.issuer, a.year].filter(Boolean).join(' · ') %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section section-tint">
  <h2>Reviews</h2>
  <p class="sub">What our customers say</p>
  <div class="review-filters">
    <a href="/about" class="<%= !reviewFilter ? 'active' : '' %>">All Reviews</a>
    <a href="/about?type=video" class="<%= reviewFilter === 'video' ? 'active' : '' %>">Video Reviews</a>
    <a href="/about?type=photo" class="<%= reviewFilter === 'photo' ? 'active' : '' %>">Photo Reviews</a>
    <a href="/about?type=text" class="<%= reviewFilter === 'text' ? 'active' : '' %>">Written Reviews</a>
  </div>
  <div class="reviews-marquee">
    <div class="reviews-track" id="reviewsTrack">
      <% testimonials.forEach(t => { %>
        <%- include('partials/testimonial-card', { t }) %>
      <% }) %>
    </div>
  </div>
  <% if (testimonials.length === 0) { %><p class="sub">No reviews match this filter yet.</p><% } %>
  <% if (settings.google_business_url) { %>
    <div style="text-align:center; margin-top:24px;">
      <a class="btn btn-outline" href="<%= settings.google_business_url %>" target="_blank" rel="noopener">See All Our Reviews on Google</a>
    </div>
  <% } %>
</section>
<script>
  (function () {
    function timeAgo(iso) {
      const diff = Date.now() - new Date(iso).getTime();
      const day = 86400000;
      const days = Math.floor(diff / day);
      if (days <= 0) return 'Today';
      if (days === 1) return '1 day ago';
      if (days < 30) return days + ' days ago';
      const months = Math.floor(days / 30);
      if (months < 12) return months + (months === 1 ? ' month ago' : ' months ago');
      const years = Math.floor(months / 12);
      return years + (years === 1 ? ' year ago' : ' years ago');
    }
    document.querySelectorAll('.review-date[data-created]').forEach(el => {
      el.textContent = timeAgo(el.getAttribute('data-created'));
    });

    const track = document.getElementById('reviewsTrack');
    if (!track) return;
    Array.from(track.children).forEach(card => track.appendChild(card.cloneNode(true)));
  })();
</script>
<section class="section section-tint" id="faq">
  <div class="container" style="max-width:760px;">
    <h2>Frequently Asked Questions</h2>
    <p class="sub">Things people usually ask before ordering</p>

    <div class="faq-list">
      <% faqs.forEach(f => { %>
        <details class="faq-item">
          <summary><%= f.question %></summary>
          <p><%= f.answer %></p>
        </details>
      <% }) %>
      <% if (faqs.length === 0) { %><p class="sub">No FAQs added yet.</p><% } %>
    </div>
  </div>
</section>

<% if (faqs.length) { %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
}) %>
</script>
<% } %>
<section class="section" id="leave-review">
  <h2>Leave a Review</h2>
  <p class="sub">Reviews are shown after approval by the team</p>
  <div class="form-box">
    <form action="/testimonials" method="POST" enctype="multipart/form-data">
      <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
      <div class="form-group">
        <label>Your Name</label>
        <input type="text" name="name" required>
      </div>
      <div class="form-group">
        <label>Rating</label>
        <select name="rating">
          <option value="5">★★★★★</option>
          <option value="4">★★★★☆</option>
          <option value="3">★★★☆☆</option>
          <option value="2">★★☆☆☆</option>
          <option value="1">★☆☆☆☆</option>
        </select>
      </div>
      <div class="form-group">
        <label>Your Review</label>
        <textarea name="message" required></textarea>
      </div>
      <div class="form-group">
        <label>Add a Photo (optional)</label>
        <input type="file" name="photo" accept="image/*">
      </div>
      <div class="form-group">
        <label>Add a Video Link (optional)</label>
        <input type="url" name="video_url" placeholder="Paste a YouTube or Google Drive link">
      </div>
      <button class="btn" type="submit">Submit Review</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
