<style>
  .social-icons {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }
  .social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(207,195,181,0.25);
    color: #cfc3b5;
    transition: all 0.2s ease;
  }
  .social-icons a:hover {
    transform: translateY(-2px);
    border-color: transparent;
  }
  .social-icons a.instagram:hover {
    background: linear-gradient(45deg, #f9ce34, #ee2a7b, #6228d7);
    color: #fff;
  }
  .social-icons a.facebook:hover { background: #1877f2; color: #fff; }
  .social-icons a.youtube:hover  { background: #ff0000; color: #fff; }
  .social-icons a.whatsapp:hover { background: #25d366; color: #fff; }
  .social-icons svg { width: 18px; height: 18px; }
</style>

