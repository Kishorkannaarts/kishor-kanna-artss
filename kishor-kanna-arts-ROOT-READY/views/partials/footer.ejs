      </div>
    </div>

    <div>
      <h4>Company</h4>
      <a href="/about">About Us</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </div>
    <div>
      <h4>Shop</h4>
      <% (artTypes || []).slice(0, 6).forEach(function(cat) { %>
        <a href="/portfolio?category=<%= encodeURIComponent(cat) %>"><%= cat %></a>
      <% }) %>
      <% if (!artTypes || !artTypes.length) { %>
        <a href="/portfolio?category=Pencil%20Portraits">Pencil Portraits</a>
        <a href="/portfolio?category=Color%20Portraits">Color Portraits</a>
        <a href="/portfolio?category=Canvas%20Paintings">Canvas Paintings</a>
        <a href="/portfolio?category=Digital%20Portraits">Digital Portraits</a>
        <a href="/portfolio?category=Blood%20Portraits">Blood Portraits</a>
      <% } %>
    </div>
    <div>
      <h4>Customer Support</h4>
      <a href="/track-order">Track Order</a>
      <a href="/about#faq">FAQ</a>
      <a href="/#reviewsTrack">Reviews</a>
    </div>
    <div>
      <h4>Legal</h4>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/shipping-policy">Shipping Policy</a>
      <a href="/refund-policy">Refund Policy</a>
      <a href="/cancellation-policy">Cancellation Policy</a>
      <a href="/terms">Terms &amp; Conditions</a>
    </div>
    <div>
      <h4>Contact</h4>
      <a href="tel:<%= settings.contact_phone %>"><%= settings.contact_phone %></a>
      <a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a>
      <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(settings.contact_address) %>" target="_blank" rel="noopener" style="color:#cfc3b5; font-size:0.9rem; text-decoration:none; display:block; margin:4px 0;"><%= settings.contact_address %></a>
      <% if (settings.business_hours) { %><span style="display:block; color:#cfc3b5; font-size:0.9rem; margin:4px 0;"><%= settings.business_hours %></span><% } %>
  </div>
  <div class="container" style="padding-bottom: var(--space-lg);">
    <div style="max-width:340px;">
      <h4 style="color:#fff; font-size:1rem; margin-bottom:14px;">Newsletter</h4>
      <p style="color:#cfc3b5; font-size:0.9rem;">Subscribe for exclusive offers, new artwork releases, and creative inspiration.</p>
      <form class="newsletter-form" action="/newsletter" method="POST">
        <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
        <input type="email" name="email" placeholder="Your email" required>
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </div>
  <div class="footer-bottom">
    &copy; <%= new Date().getFullYear() %> <%= settings.site_name %>. All Rights Reserved.
  </div>
</footer>

<% if (!isAdmin) { %>
<style>
  .kka-chat-bubble {
    position: fixed; right: 22px; <%= settings.whatsapp_number ? 'bottom: 94px;' : 'bottom: 22px;' %> z-index: 9997;
    width: 56px; height: 56px; border-radius: 50%; background: var(--accent, #b6472e);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    box-shadow: 0 6px 20px rgba(0,0,0,0.3); border: none;
  }
  .kka-chat-bubble.hidden { display: none; }
  .kka-chat-bubble svg { width: 26px; height: 26px; fill: #fff; }
  .kka-chat-panel {
    position: fixed; right: 22px; bottom: 22px; z-index: 9999;
    width: min(340px, calc(100vw - 32px)); height: min(460px, calc(100vh - 100px));
    background: #fff; border-radius: 14px; box-shadow: 0 10px 40px rgba(0,0,0,0.35);
    display: none; flex-direction: column; overflow: hidden;
  }
  .kka-chat-panel.open { display: flex; }
  .kka-chat-header {
    background: var(--accent, #b6472e); color: #fff; padding: 12px 14px;
    display: flex; align-items: center; justify-content: space-between; font-weight: 600;
  }
  .kka-chat-header button {
    background: transparent; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; line-height: 1;
  }
  .kka-chat-log { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: #f7f5f2; }
  .kka-chat-msg { max-width: 82%; padding: 8px 12px; border-radius: 12px; font-size: 0.9rem; line-height: 1.4; white-space: pre-wrap; }
  .kka-chat-msg-bot { background: #fff; border: 1px solid #eee; align-self: flex-start; }
  .kka-chat-msg-user { background: var(--accent, #b6472e); color: #fff; align-self: flex-end; }
  .kka-chat-typing { opacity: 0.6; }
  .kka-chat-form { display: flex; gap: 8px; padding: 10px; border-top: 1px solid #eee; background: #fff; }
  .kka-chat-form input { flex: 1; border: 1px solid #ddd; border-radius: 20px; padding: 8px 14px; font-size: 0.9rem; }
  .kka-chat-form button { background: var(--accent, #b6472e); color: #fff; border: none; border-radius: 20px; padding: 8px 16px; font-size: 0.9rem; cursor: pointer; }
  @media (max-width: 640px) {
    .kka-chat-bubble { right: 16px; <%= settings.whatsapp_number ? 'bottom: 82px;' : 'bottom: 16px;' %> width: 50px; height: 50px; }
    .kka-chat-panel { right: 16px; bottom: 16px; }
  }
</style>
<button id="kka-chat-bubble" class="kka-chat-bubble" aria-label="Chat with us">
  <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
</button>
<div id="kka-chat-panel" class="kka-chat-panel">
  <div class="kka-chat-header">
    <span>Chat with us</span>
    <button id="kka-chat-close" type="button" aria-label="Close chat">&times;</button>
  </div>
  <div id="kka-chat-log" class="kka-chat-log"></div>
  <form id="kka-chat-form" class="kka-chat-form">
    <input id="kka-chat-input" type="text" placeholder="Type a message..." autocomplete="off" maxlength="800">
    <button type="submit">Send</button>
  </form>
</div>
<script src="/public/js/chat-widget.js?v=1" defer></script>
<% } %>

<% if (settings.whatsapp_number && !isAdmin) { %>
<style>
  .wa-float-btn {
    position: fixed; right: 22px; bottom: 22px; z-index: 9998;
    width: 60px; height: 60px; border-radius: 50%; background: #25d366;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 20px rgba(0,0,0,0.3); text-decoration: none;
    animation: wa-pulse 2.2s infinite;
  }
  .wa-float-btn svg { width: 32px; height: 32px; fill: #fff; }
  .wa-float-btn:hover { transform: scale(1.06); }
  @keyframes wa-pulse {
    0% { box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 0 rgba(37,211,102,0.5); }
    70% { box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 14px rgba(37,211,102,0); }
    100% { box-shadow: 0 6px 20px rgba(0,0,0,0.3), 0 0 0 0 rgba(37,211,102,0); }
  }
  .wa-tooltip {
    position: fixed; right: 92px; bottom: 36px; z-index: 9998;
    background: #111; color: #fff; padding: 8px 14px; border-radius: 8px;
    font-size: 0.85rem; white-space: nowrap; opacity: 0; pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .wa-float-wrap:hover .wa-tooltip { opacity: 1; }
  @media (max-width: 640px) {
    .wa-float-btn { right: 16px; bottom: 16px; width: 54px; height: 54px; }
    .wa-tooltip { display: none; }
  }
</style>
<div class="wa-float-wrap">
  <span class="wa-tooltip">Chat with us on WhatsApp</span>
  <a class="wa-float-btn" href="https://wa.me/<%= settings.whatsapp_number.replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent(settings.whatsapp_default_message || 'Hi! I would like to know more about custom artwork.') %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3s19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
  </a>
</div>
<% } %>
<script>
  // Adds the CSRF token to every POST form on the page automatically, so
  // individual templates never need to remember to include it by hand.
  document.querySelectorAll('form[method="POST"], form[method="post"]').forEach(function (f) {
    var i = document.createElement('input');
    i.type = 'hidden';
    i.name = '_csrf';
    i.value = "<%= csrfToken %>";
    f.appendChild(i);
  });
</script>
<script src="/public/js/main.js?v=10" defer></script>
</body>
</html>
