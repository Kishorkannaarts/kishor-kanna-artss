<%
  // `activeTab` is set by whichever page includes this partial. Falls back
  // to 'orders' so nothing breaks if a page forgets to set it.
  const _tab = typeof activeTab !== 'undefined' ? activeTab : 'orders';
%>
<div class="account-nav">
  <a href="/account/dashboard" class="<%= _tab === 'orders' ? 'active' : '' %>">My Orders</a>
  <a href="/account/profile" class="<%= _tab === 'profile' ? 'active' : '' %>">Profile</a>
  <a href="/account/addresses" class="<%= _tab === 'addresses' ? 'active' : '' %>">Saved Addresses</a>
  <a href="/account/wishlist" class="<%= _tab === 'wishlist' ? 'active' : '' %>">Wishlist</a>
</div>
