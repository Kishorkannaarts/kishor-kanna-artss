<% pageTitle = settings.seo_shop_title || 'Shop Custom Art & Portraits' %>
<% pageDescription = settings.seo_shop_description || `Browse pencil, colour, pen, blood, digital and canvas portraits from ${settings.site_name}. Choose a style and size, then order a custom piece made from your photo.` %>
<%- include('partials/header') %>

<div class="container" style="padding-top:18px;">
  <% crumbs = [{ name: 'Home', url: '/' }, { name: 'Shop' }]; %>
  <%- include('partials/breadcrumbs') %>
</div>

<section class="section" style="padding-top:0;">
  <div class="container">
    <h2>Shop Portraits</h2>

    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
      <p class="sub" style="margin-top:-10px;">Showing results for "<strong><%= searchQuery %></strong>" — <a href="/portfolio">clear search</a></p>
    <% } %>

    <div class="shop-layout">
      <!-- Sidebar -->
      <aside class="shop-sidebar">
        <div class="filter-group">
          <h4>Categories</h4>
          <a class="filter-link <%= !activeCategory ? 'active' : '' %>" href="/portfolio">All</a>
          <% categories.forEach(c => { %>
            <a class="filter-link <%= activeCategory === c ? 'active' : '' %>" href="/portfolio?category=<%= encodeURIComponent(c) %>"><%= c %></a>
          <% }) %>
        </div>

        <div class="filter-group">
          <h4>Size</h4>
          <% (sizes || []).forEach(function(s){ %>
            <label class="filter-checkbox"><input type="checkbox" class="size-filter" value="<%= s %>"> <%= s %></label>
          <% }) %>
        </div>

        <div class="filter-group">
          <h4>Price</h4>
          <label class="filter-checkbox"><input type="checkbox" class="price-filter" data-min="0" data-max="999"> ₹0 – ₹999</label>
          <label class="filter-checkbox"><input type="checkbox" class="price-filter" data-min="999" data-max="1499"> ₹999 – ₹1499</label>
          <label class="filter-checkbox"><input type="checkbox" class="price-filter" data-min="1499" data-max="2499"> ₹1499 – ₹2499</label>
          <label class="filter-checkbox"><input type="checkbox" class="price-filter" data-min="2499" data-max="999999"> ₹2499+</label>
        </div>

        <button type="button" class="btn btn-outline" id="clearFilters" style="width:100%;">Clear Filters</button>
      </aside>

      <!-- Main grid -->
      <div class="shop-main">
        <div class="shop-toolbar">
          <span id="resultCount" class="sub" style="margin:0;"><%= artworks.length %> results</span>
          <select id="sortSelect">
            <option value="default">Sort: Popular</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="newest">Newest First</option>
          </select>
        </div>

        <div class="grid grid-2 grid-arts" id="shopGrid">
          <% artworks.forEach((a, i) => { %>
            <div class="card" style="position:relative;" data-category="<%= a.category %>" data-size="<%= a.size || '' %>" data-price="<%= a.price || 0 %>" data-order="<%= i %>">
              <a href="/portfolio/<%= a.id %>">
                <img src="<%= a.image || 'https://placehold.co/400x300?text=Artwork' %>" alt="<%= a.title %>" loading="lazy" decoding="async" class="lightbox-trigger" data-full="<%= a.image || 'https://placehold.co/1200x1200?text=Artwork' %>" data-title="<%= a.title %>" data-category="<%= a.category %>">
              </a>
              <button type="button" class="lightbox-open-btn" aria-label="View <%= a.title %> fullscreen" data-full="<%= a.image || 'https://placehold.co/1200x1200?text=Artwork' %>" data-title="<%= a.title %>" data-category="<%= a.category %>">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              </button>
              <% if (isCustomer) { %>
                <% const wished = typeof wishlistIds !== 'undefined' && wishlistIds.includes(a.id); %>
                <form action="/wishlist/<%= a.id %>/toggle" method="POST" class="wishlist-heart-form">
                  <input type="hidden" name="redirect_to" value="/portfolio<%= activeCategory ? '?category=' + encodeURIComponent(activeCategory) : '' %>">
                  <button type="submit" class="wishlist-heart <%= wished ? 'is-wished' : '' %>" aria-label="<%= wished ? 'Remove from wishlist' : 'Save to wishlist' %>"><%- '&#10084;' %></button>
                </form>
              <% } else { %>
                <a href="/account/login?next=<%= encodeURIComponent('/portfolio') %>" class="wishlist-heart" aria-label="Log in to save to wishlist"><%- '&#10084;' %></a>
              <% } %>
              <div class="card-body">
                <span class="tag"><%= a.category %></span>
                <h3><a href="/portfolio/<%= a.id %>" style="color:inherit; text-decoration:none;"><%= a.title %></a></h3>
                <p><%= a.description %></p>
                <div class="card-footer">
                  <div class="meta">
                    <% if (a.size) { %><span>Size: <strong><%= a.size %></strong></span><% } %>
                    <% if (a.price) { %><span style="margin-left:10px;">From ₹<strong><%= a.price %></strong></span><% } %>
                  </div>
                  <a class="btn btn-sm btn-primary" href="/order?art_type=<%= encodeURIComponent(a.category) %>&size=<%= encodeURIComponent(a.size || '') %>&price=<%= encodeURIComponent(a.price || '') %>">Order This</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <p class="sub" id="noResultsMsg" style="display:none;">No portraits match those filters — try clearing some.</p>
        <% if (artworks.length === 0) { %>
          <p class="sub">No artworks in this category yet.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var grid = document.getElementById('shopGrid');
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.card'));
    var sizeBoxes = document.querySelectorAll('.size-filter');
    var priceBoxes = document.querySelectorAll('.price-filter');
    var sortSelect = document.getElementById('sortSelect');
    var resultCount = document.getElementById('resultCount');
    var noResultsMsg = document.getElementById('noResultsMsg');

    function applyFilters() {
      var checkedSizes = Array.prototype.slice.call(sizeBoxes).filter(b => b.checked).map(b => b.value);
      var checkedPrices = Array.prototype.slice.call(priceBoxes).filter(b => b.checked);
      var visibleCount = 0;

      cards.forEach(function (card) {
        var size = card.getAttribute('data-size');
        var price = parseFloat(card.getAttribute('data-price')) || 0;
        var sizeOk = checkedSizes.length === 0 || checkedSizes.indexOf(size) !== -1;
        var priceOk = checkedPrices.length === 0 || checkedPrices.some(b => price >= +b.dataset.min && price <= +b.dataset.max);
        var show = sizeOk && priceOk;
        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      resultCount.textContent = visibleCount + ' results';
      noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function applySort() {
      var sorted = cards.slice().sort(function (a, b) {
        var val = sortSelect.value;
        if (val === 'price-asc') return (+a.dataset.price) - (+b.dataset.price);
        if (val === 'price-desc') return (+b.dataset.price) - (+a.dataset.price);
        if (val === 'newest') return (+a.dataset.order) - (+b.dataset.order);
        return 0;
      });
      sorted.forEach(function (card) { grid.appendChild(card); });
    }

    sizeBoxes.forEach(b => b.addEventListener('change', applyFilters));
    priceBoxes.forEach(b => b.addEventListener('change', applyFilters));
    sortSelect.addEventListener('change', applySort);
    document.getElementById('clearFilters').addEventListener('click', function () {
      sizeBoxes.forEach(b => b.checked = false);
      priceBoxes.forEach(b => b.checked = false);
      applyFilters();
    });
  })();
</script>

<!-- Fullscreen lightbox viewer -->
<div class="lightbox-overlay" id="lightboxOverlay" role="dialog" aria-modal="true" aria-label="Artwork fullscreen viewer" hidden>
  <button type="button" class="lightbox-close" id="lightboxClose" aria-label="Close fullscreen viewer">&times;</button>
  <button type="button" class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Previous artwork">&#8249;</button>
  <div class="lightbox-content">
    <img id="lightboxImage" src="" alt="">
    <div class="lightbox-caption">
      <span id="lightboxTitle"></span>
      <span class="tag" id="lightboxCategory"></span>
    </div>
  </div>
  <button type="button" class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Next artwork">&#8250;</button>
</div>

<script>
  (function () {
    var overlay = document.getElementById('lightboxOverlay');
    var imgEl = document.getElementById('lightboxImage');
    var titleEl = document.getElementById('lightboxTitle');
    var catEl = document.getElementById('lightboxCategory');
    var closeBtn = document.getElementById('lightboxClose');
    var prevBtn = document.getElementById('lightboxPrev');
    var nextBtn = document.getElementById('lightboxNext');
    var currentIndex = 0;

    function visibleItems() {
      // Only cycle through cards the current filters haven't hidden.
      return Array.prototype.slice.call(document.querySelectorAll('.lightbox-open-btn'))
        .filter(function (btn) { return btn.closest('.card').style.display !== 'none'; });
    }

    function openAt(index) {
      var items = visibleItems();
      if (!items.length) return;
      currentIndex = (index + items.length) % items.length;
      var btn = items[currentIndex];
      imgEl.src = btn.getAttribute('data-full');
      imgEl.alt = btn.getAttribute('data-title');
      titleEl.textContent = btn.getAttribute('data-title');
      catEl.textContent = btn.getAttribute('data-category');
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.lightbox-open-btn').forEach(function (btn, i) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        openAt(visibleItems().indexOf(btn));
      });
    });

    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
    prevBtn.addEventListener('click', function () { openAt(currentIndex - 1); });
    nextBtn.addEventListener('click', function () { openAt(currentIndex + 1); });

    document.addEventListener('keydown', function (e) {
      if (overlay.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') openAt(currentIndex - 1);
      if (e.key === 'ArrowRight') openAt(currentIndex + 1);
    });
  })();
</script>

<%- include('partials/footer') %>
