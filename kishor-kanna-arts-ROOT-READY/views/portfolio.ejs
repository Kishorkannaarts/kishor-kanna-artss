<% pageTitle = 'Portfolio' %>
<% pageDescription = `Browse hand-made portraits by ${settings.site_name} — pencil, colour, pen and canvas art. See real work before you order.` %>
<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <h2>Portfolio</h2>
    <p class="sub">Browse artworks by category</p>

    <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
      <p class="sub" style="margin-top:-14px;">Showing results for "<strong><%= searchQuery %></strong>" — <a href="/portfolio">clear search</a></p>
    <% } %>

    <div class="pills">
      <a class="pill <%= !activeCategory ? 'active' : '' %>" href="/portfolio">All</a>
      <% categories.forEach(c => { %>
        <a class="pill <%= activeCategory === c ? 'active' : '' %>" href="/portfolio?category=<%= encodeURIComponent(c) %>"><%= c %></a>
      <% }) %>
    </div>

    <div class="grid grid-3 grid-arts">
      <% artworks.forEach(a => { %>
        <div class="card">
          <a href="/portfolio/<%= a.id %>">
            <img src="<%= a.image || 'https://placehold.co/400x300?text=Artwork' %>" alt="<%= a.title %>" loading="lazy" decoding="async">
          </a>
          <div class="card-body">
            <span class="tag"><%= a.category %></span>
            <h3><a href="/portfolio/<%= a.id %>" style="color:inherit; text-decoration:none;"><%= a.title %></a></h3>
            <p><%= a.description %></p>
            <div class="card-footer">
              <div class="meta">
                <% if (a.size) { %><span>Size: <strong><%= a.size %></strong></span><% } %>
                <% if (a.price) { %><span style="margin-left:10px;">₹<strong><%= a.price %></strong></span><% } %>
              </div>
              <a class="btn btn-sm btn-primary" href="/order?art_type=<%= encodeURIComponent(a.category) %>&size=<%= encodeURIComponent(a.size || '') %>&price=<%= encodeURIComponent(a.price || '') %>">Order This</a>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (artworks.length === 0) { %>
        <p class="sub">No artworks in this category yet.</p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
