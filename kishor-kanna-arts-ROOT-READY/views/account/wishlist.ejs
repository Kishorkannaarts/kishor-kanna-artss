<% pageTitle = 'My Wishlist' %>
<%- include('../partials/header') %>

<section class="section">
  <div class="account-header">
    <div>
      <h2>Hi, <%= customer.name %></h2>
      <p class="sub">Artworks you've saved to think over or order later.</p>
    </div>
  </div>

  <% activeTab = 'wishlist' %>
  <%- include('../partials/account-nav') %>

  <% if (!artworks.length) { %>
    <p class="sub" style="margin-top:28px;">Nothing saved yet. <a href="/portfolio">Browse the portfolio</a> and tap the heart on anything you like.</p>
  <% } else { %>
    <div class="grid grid-2 grid-arts" style="margin-top:28px;">
      <% artworks.forEach(a => { %>
        <div class="card">
          <a href="/portfolio/<%= a.id %>">
            <img src="<%= a.image || 'https://placehold.co/400x300?text=Artwork' %>" alt="<%= a.title %>" loading="lazy" decoding="async">
          </a>
          <div class="card-body">
            <span class="tag"><%= a.category %></span>
            <h3><a href="/portfolio/<%= a.id %>" style="color:inherit; text-decoration:none;"><%= a.title %></a></h3>
            <div class="card-footer">
              <div class="meta">
                <% if (a.price) { %><span>₹<strong><%= a.price %></strong></span><% } %>
              </div>
              <div style="display:flex; gap:8px;">
                <a class="btn btn-sm btn-primary" href="/order?art_type=<%= encodeURIComponent(a.category) %>&size=<%= encodeURIComponent(a.size || '') %>&price=<%= encodeURIComponent(a.price || '') %>">Order This</a>
                <form action="/wishlist/<%= a.id %>/toggle" method="POST">
                  <input type="hidden" name="redirect_to" value="/account/wishlist">
                  <button class="btn btn-sm btn-outline" type="submit">Remove</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
