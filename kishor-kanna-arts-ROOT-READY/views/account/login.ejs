<% pageTitle = 'Login' %>
<%- include('../partials/header') %>

<section class="section">
  <h2>Log In</h2>
  <p class="sub">Access your orders, addresses and past artworks.</p>

  <div class="form-box" style="max-width:420px;">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/account/login<%= typeof next !== 'undefined' && next ? '?next=' + encodeURIComponent(next) : '' %>" method="POST">
      <div class="form-group"><label>Email</label><input type="email" name="email" value="<%= oldEmail %>" required autofocus></div>
      <div class="form-group"><label>Password</label><input type="password" name="password" required></div>
      <button class="btn btn-primary" type="submit" style="width:100%;">Log In</button>
    </form>
    <p class="sub" style="margin-top:16px;">New here? <a href="/account/signup">Create an account</a></p>
  </div>
</section>

<%- include('../partials/footer') %>
