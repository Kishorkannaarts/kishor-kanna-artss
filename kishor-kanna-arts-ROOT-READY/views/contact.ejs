<% pageTitle = 'Contact' %>
<% pageDescription = `Get in touch with ${settings.site_name} — ask about a custom portrait, check pricing, or say hello. We reply fast.` %>
<%- include('partials/header') %>

<section class="section">
  <div class="container" style="max-width:760px;">
    <h2>Get in Touch</h2>
    <p class="sub">We'd love to hear from you. Feel free to reach out for any queries or questions.</p>

    <div class="grid grid-2" style="margin-bottom:30px;">
      <a class="card reveal" href="tel:<%= settings.contact_phone %>" style="text-decoration:none; color:inherit; padding:18px; display:flex; align-items:center; gap:12px;">
        <span style="font-size:1.4rem;">📞</span>
        <div><strong>Phone</strong><br><span class="sub" style="margin:0;"><%= settings.contact_phone %></span></div>
      </a>
      <a class="card reveal" href="mailto:<%= settings.contact_email %>" style="text-decoration:none; color:inherit; padding:18px; display:flex; align-items:center; gap:12px;">
        <span style="font-size:1.4rem;">✉️</span>
        <div><strong>Email</strong><br><span class="sub" style="margin:0;"><%= settings.contact_email %></span></div>
      </a>
      <% if (settings.whatsapp_number) { %>
      <a class="card reveal" href="https://wa.me/<%= settings.whatsapp_number.replace(/[^0-9]/g,'') %>" target="_blank" rel="noopener" style="text-decoration:none; color:inherit; padding:18px; display:flex; align-items:center; gap:12px;">
        <span style="font-size:1.4rem;">💬</span>
        <div><strong>WhatsApp</strong><br><span class="sub" style="margin:0;"><%= settings.whatsapp_number %></span></div>
      </a>
      <% } %>
      <% if (settings.contact_address) { %>
      <a class="card reveal" href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(settings.contact_address) %>" target="_blank" rel="noopener" style="text-decoration:none; color:inherit; padding:18px; display:flex; align-items:center; gap:12px;">
        <span style="font-size:1.4rem;">📍</span>
        <div><strong>Location</strong><br><span class="sub" style="margin:0;"><%= settings.contact_address %></span></div>
      </a>
      <% } %>
      <% if (settings.business_hours) { %>
      <div class="card reveal" style="padding:18px; display:flex; align-items:center; gap:12px;">
        <span style="font-size:1.4rem;">🕒</span>
        <div><strong>Working Hours</strong><br><span class="sub" style="margin:0;"><%= settings.business_hours %></span></div>
      </div>
      <% } %>
    </div>

    <div class="form-box">
      <% if (sent) { %>
        <div class="alert alert-success">Thanks! Your message has been sent — we'll get back to you soon.</div>
      <% } %>
      <form action="/contact" method="POST">
        <div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
        <div class="form-row">
          <div class="form-group"><label>Your Name</label><input type="text" name="name" required></div>
          <div class="form-group"><label>Phone Number</label><input type="text" name="phone"></div>
        </div>
        <div class="form-group"><label>Email Address</label><input type="email" name="email" required></div>
        <div class="form-group"><label>Subject</label><input type="text" name="subject"></div>
        <div class="form-group"><label>Your Message</label><textarea name="message" required></textarea></div>
        <button class="btn btn-gold" type="submit">Send Message</button>
      </form>
    </div>

    <% if (settings.google_maps_embed) { %>
      <div style="margin:36px auto 0;">
        <h3 style="text-align:center;">Find Us</h3>
        <iframe src="<%= settings.google_maps_embed %>" width="100%" height="360" style="border:0; border-radius:14px;" allowfullscreen="" loading="lazy"></iframe>
      </div>
    <% } %>

    <% if (settings.google_business_url) { %>
      <div style="text-align:center; margin-top:20px;">
        <a class="btn btn-outline" href="<%= settings.google_business_url %>" target="_blank" rel="noopener">See All Our Reviews on Google</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
