<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Email Templates | Admin</title><link rel="stylesheet" href="/public/css/admin.css"></head>
<body class="admin">
<div class="admin-shell">
  <% active = 'email-templates' %>
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar"><h1>Email Templates</h1></div>
    <p style="color:var(--muted); font-size:0.9rem; max-width:640px;">
      These control the wording of every automatic email the site sends. You can use these placeholders
      anywhere in the subject or message and they'll be filled in automatically:
      <code>{{name}} {{order_code}} {{art_type}} {{size}} {{amount}} {{payment_link}} {{track_url}} {{site_name}} {{status}} {{reason}} {{artwork_image}} {{artwork_note}} {{progress_image}} {{progress_note}} {{video_url}} {{courier_name}} {{tracking_number}} {{tracking_url}} {{review_url}} {{email}} {{phone}} {{subject}} {{message}} {{rating}}</code>
      (not every placeholder applies to every template — unused ones are simply left blank).
    </p>

    <form class="admin-form" action="/admin/email-templates/save" method="POST" style="max-width:700px;">

      <div class="form-group"><label>Default Payment Link (used to pre-fill payment request emails)</label>
        <input type="text" name="default_payment_link" value="<%= settings.default_payment_link %>" placeholder="Paste your UPI / Razorpay / payment page link">
      </div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">1. Order Received (sent instantly when a customer places an order)</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_order_received_subject" value="<%= settings.tmpl_order_received_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_order_received_body" style="min-height:140px;"><%= settings.tmpl_order_received_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">2. Status Update (sent whenever you change the status dropdown in Orders)</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_status_update_subject" value="<%= settings.tmpl_status_update_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_status_update_body" style="min-height:120px;"><%= settings.tmpl_status_update_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">3. Advance Payment Request (sent when you click "Request Advance Payment")</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_advance_subject" value="<%= settings.tmpl_advance_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_advance_body" style="min-height:140px;"><%= settings.tmpl_advance_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">4. Reject / Ask New Date (sent when you click "Reject & Ask For a New Date")</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_reject_subject" value="<%= settings.tmpl_reject_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_reject_body" style="min-height:120px;"><%= settings.tmpl_reject_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">5. Balance Payment Request (sent when you click "Request Balance Payment")</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_balance_subject" value="<%= settings.tmpl_balance_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_balance_body" style="min-height:140px;"><%= settings.tmpl_balance_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">6. Shipped / Order Sent (sent when you click "Mark as Sent")</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_shipped_subject" value="<%= settings.tmpl_shipped_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_shipped_body" style="min-height:100px;"><%= settings.tmpl_shipped_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">7. Artwork Ready for Confirmation (sent when you click "Send Final Artwork")</h3>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">Extra placeholders for this one: <code>{{artwork_image}} {{artwork_note}}</code></p>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_artwork_ready_subject" value="<%= settings.tmpl_artwork_ready_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_artwork_ready_body" style="min-height:160px;"><%= settings.tmpl_artwork_ready_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">8. Progress Update (sent when you click "Send Progress Update")</h3>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">Extra placeholders: <code>{{progress_image}} {{progress_note}}</code></p>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_progress_update_subject" value="<%= settings.tmpl_progress_update_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_progress_update_body" style="min-height:120px;"><%= settings.tmpl_progress_update_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">9. Making Video (sent when you click "Share Making Video")</h3>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">Extra placeholder: <code>{{video_url}}</code></p>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_making_video_subject" value="<%= settings.tmpl_making_video_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_making_video_body" style="min-height:100px;"><%= settings.tmpl_making_video_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">10. Packing (sent when you click "Mark Packing")</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_packing_subject" value="<%= settings.tmpl_packing_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_packing_body" style="min-height:100px;"><%= settings.tmpl_packing_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">11. Tracking Info (sent when you click "Add Tracking Info")</h3>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">Extra placeholders: <code>{{courier_name}} {{tracking_number}} {{tracking_url}}</code></p>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_tracking_subject" value="<%= settings.tmpl_tracking_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_tracking_body" style="min-height:120px;"><%= settings.tmpl_tracking_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">12. Delivered (sent when you click "Mark Delivered")</h3>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_delivered_subject" value="<%= settings.tmpl_delivered_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_delivered_body" style="min-height:100px;"><%= settings.tmpl_delivered_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">13. Review Request (sent when you click "Send Review Request")</h3>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">Extra placeholder: <code>{{review_url}}</code></p>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_review_request_subject" value="<%= settings.tmpl_review_request_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_review_request_body" style="min-height:120px;"><%= settings.tmpl_review_request_body %></textarea></div>

      <hr style="border-color:var(--border); margin:24px 0;">
      <h3 style="font-size:1rem;">Admin Alerts</h3>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">These are sent to your own inbox (set <code>NOTIFY_EMAIL</code> in <code>.env</code>), not the customer.</p>

      <h4 style="font-size:0.9rem; margin-top:16px;">14. Advance Paid</h4>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_advance_paid_admin_subject" value="<%= settings.tmpl_advance_paid_admin_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_advance_paid_admin_body" style="min-height:80px;"><%= settings.tmpl_advance_paid_admin_body %></textarea></div>

      <h4 style="font-size:0.9rem; margin-top:16px;">15. Final Payment Received</h4>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_balance_paid_admin_subject" value="<%= settings.tmpl_balance_paid_admin_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_balance_paid_admin_body" style="min-height:80px;"><%= settings.tmpl_balance_paid_admin_body %></textarea></div>

      <h4 style="font-size:0.9rem; margin-top:16px;">16. Contact Form Message</h4>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">Extra placeholders: <code>{{email}} {{phone}} {{subject}} {{message}}</code></p>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_contact_form_admin_subject" value="<%= settings.tmpl_contact_form_admin_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_contact_form_admin_body" style="min-height:100px;"><%= settings.tmpl_contact_form_admin_body %></textarea></div>

      <h4 style="font-size:0.9rem; margin-top:16px;">17. New Review Submitted</h4>
      <p style="color:var(--muted); font-size:0.85rem; margin-top:-8px;">Extra placeholders: <code>{{message}} {{rating}}</code></p>
      <div class="form-group"><label>Subject</label><input type="text" name="tmpl_new_review_admin_subject" value="<%= settings.tmpl_new_review_admin_subject %>"></div>
      <div class="form-group"><label>Message</label><textarea name="tmpl_new_review_admin_body" style="min-height:100px;"><%= settings.tmpl_new_review_admin_body %></textarea></div>

      <br>
      <button class="btn btn-primary" type="submit">Save All Templates</button>
    </form>
  </div>
</div>
</body></html>
