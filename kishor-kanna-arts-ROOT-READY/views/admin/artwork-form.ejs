<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= artwork ? 'Edit' : 'Add' %> Artwork | Admin</title><link rel="stylesheet" href="/public/css/admin.css"></head>
<body class="admin">
<div class="admin-shell">
  <% active = 'artworks' %>
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar"><h1><%= artwork ? 'Edit' : 'Add' %> Artwork</h1></div>
    <form class="admin-form" action="/admin/artworks/save" method="POST" enctype="multipart/form-data">
      <% if (artwork) { %><input type="hidden" name="id" value="<%= artwork.id %>"><% } %>
      <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" value="<%= artwork ? artwork.title : '' %>" required>
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="category" required>
          <% artTypes.forEach(c => { %>
            <option value="<%= c %>" <%= artwork && artwork.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
        <small style="color:var(--muted); display:block; margin-top:4px;">Need a new art type? Add it under <a href="/admin/taxonomy">Art Types &amp; Sizes</a>.</small>
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea name="description"><%= artwork ? artwork.description : '' %></textarea>
      </div>
      <div class="form-group">
        <label>Story (optional background story of the piece)</label>
        <textarea name="story"><%= artwork ? artwork.story : '' %></textarea>
      </div>
      <div class="form-group">
        <label>Size</label>
        <input type="text" name="size" list="sizeOptions" value="<%= artwork ? artwork.size : '' %>" placeholder="e.g. A4">
        <datalist id="sizeOptions">
          <% sizes.forEach(sz => { %><option value="<%= sz %>"><% }) %>
        </datalist>
      </div>
      <div class="form-group">
        <label>Price</label>
        <input type="text" name="price" value="<%= artwork ? artwork.price : '' %>" placeholder="e.g. ₹1500">
      </div>
      <div class="form-group">
        <label>Image (upload to <%= artwork && artwork.image ? 'replace current image' : 'add image' %>)</label>
        <% if (artwork && artwork.image) { %><img class="thumb" src="<%= artwork.image %>" style="margin-bottom:10px;"><% } %>
        <input type="file" name="image" accept="image/*">
      </div>

      <% if (artwork && artwork.image) { %>
      <div class="form-group">
        <label>AI Image Tools</label>
        <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:8px;">
          <form action="/admin/artworks/<%= artwork.id %>/remove-bg" method="POST" style="margin:0;">
            <button class="btn btn-ghost" type="submit">Remove Background</button>
          </form>
          <form action="/admin/artworks/<%= artwork.id %>/upscale" method="POST" style="margin:0;">
            <button class="btn btn-ghost" type="submit">AI Upscale</button>
          </form>
          <% if (artwork.image_original && artwork.image_original !== artwork.image) { %>
          <form action="/admin/artworks/<%= artwork.id %>/revert-image" method="POST" style="margin:0;">
            <button class="btn btn-ghost" type="submit">Revert to Original</button>
          </form>
          <% } %>
        </div>
        <% if (ai === 'bg_ok') { %><p style="color:#2e7d32;">Background removed — image updated above.</p><% } %>
        <% if (ai === 'upscale_ok') { %><p style="color:#2e7d32;">Image upscaled — updated above.</p><% } %>
        <% if (ai === 'revert_ok') { %><p style="color:#2e7d32;">Reverted to the original image.</p><% } %>
        <% if (ai === 'bg_error' || ai === 'upscale_error') { %><p style="color:#c0392b;">That AI transform failed. Make sure Background Removal / AI Upscale are enabled as add-ons on your Cloudinary account, then check the server logs for details.</p><% } %>
        <small style="color:var(--muted); display:block;">These run instantly on the saved image (no need to click "Save Artwork" first). The very first original is kept so you can always revert.</small>
      </div>
      <% } %>
      <div class="form-group">
        <label><input type="checkbox" name="featured" style="width:auto; display:inline;" <%= artwork && artwork.featured ? 'checked' : '' %>> Show on Home Page (Featured)</label>
      </div>
      <button class="btn btn-primary" type="submit">Save Artwork</button>
      <a class="btn btn-ghost" href="/admin/artworks">Cancel</a>
    </form>
  </div>
</div>
</body></html>
