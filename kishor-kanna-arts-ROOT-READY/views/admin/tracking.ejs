<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tracking Info | Admin</title><link rel="stylesheet" href="/public/css/admin.css"></head>
<body class="admin">
<div class="admin-shell">
  <% active = 'orders' %>
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="admin-topbar"><h1>Add Tracking Info & Mark Shipped</h1></div>
    <p style="color:var(--muted); margin-top:-10px;">Order <%= order.order_code %> — <%= order.name %> (<%= order.email || 'no email on file' %>)</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>

    <form class="admin-form" action="/admin/orders/<%= order.id %>/tracking" method="POST">
      <div class="form-group">
        <label>Courier Name</label>
        <input type="text" name="courier_name" value="<%= order.courier_name || '' %>" placeholder="e.g. Delhivery, India Post, Blue Dart">
      </div>
      <div class="form-group">
        <label>Tracking Number</label>
        <input type="text" name="tracking_number" value="<%= order.tracking_number || '' %>" placeholder="e.g. 1234567890">
      </div>
      <div class="form-group">
        <label>Tracking Link (optional)</label>
        <input type="text" name="tracking_url" value="<%= order.tracking_url || '' %>" placeholder="https://...">
      </div>
      <button class="btn btn-primary" type="submit">Send Tracking Details & Mark Shipped</button>
      <a class="btn btn-ghost" href="/admin/orders">Cancel</a>
    </form>
  </div>
</div>
</body></html>
