<% pageTitle = 'Services' %>
<% pageDescription = `Custom art services from ${settings.site_name} — pencil portraits, colour portraits, canvas paintings, pet and family portraits, and corporate gifting.` %>
<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <h2>Services</h2>
    <p class="sub">Choose a service and size to get started</p>
    <div class="grid grid-2 grid-services">
      <%
        // Matches each service card to one of the mega-menu's anchor links
        // in the header (Pencil/Color/Canvas/Couple/Pet) by keyword, so
        // "/services#pencil" etc. actually lands on the right card instead
        // of just the top of the page. First matching keyword wins; a
        // service whose title doesn't match any of these just gets no id,
        // which is harmless.
        const usedAnchors = new Set();
        function anchorId(title) {
          const t = (title || '').toLowerCase();
          const rules = [
            ['pencil', 'pencil'],
            ['colour', 'color'], ['color', 'color'],
            ['canvas', 'canvas'],
            ['couple', 'couple'], ['wedding', 'couple'],
            ['pet', 'pet']
          ];
          for (const [keyword, id] of rules) {
            if (t.includes(keyword) && !usedAnchors.has(id)) { usedAnchors.add(id); return id; }
          }
          return null;
        }
      %>
      <% services.forEach(s => { const aid = anchorId(s.title); %>
        <div class="card"<% if (aid) { %> id="<%= aid %>" style="scroll-margin-top: calc(var(--header-h, 76px) + 16px);"<% } %>>
          <img src="<%= s.image || 'https://placehold.co/400x300?text=Service' %>" alt="<%= s.title %>" loading="lazy" decoding="async">
          <div class="card-body">
            <h3><%= s.title %></h3>
            <p><%= s.description %></p>
            <table style="width:100%; font-size:0.9rem; margin-bottom:14px; border-collapse:collapse;">
              <% sizes.forEach(sz => { const p = priceForSize(s, sz); %>
                <% if (p) { %><tr><td style="padding:4px 0; color:var(--text-secondary);"><%= sz %></td><td style="text-align:right; padding:4px 0; font-weight:600;"><%= sz.toLowerCase() === 'custom' ? 'from ' + p : p %></td></tr><% } %>
              <% }) %>
            </table>
            <% if (priceForSize(s, sizes.find(sz => sz.toLowerCase() === 'custom') || 'Custom')) { %><p class="sub" style="text-align:left; font-size:0.8rem; margin:-8px 0 12px;">Custom sizes: final price confirmed after we review your request.</p><% } %>
            <a class="btn btn-primary" href="/order">Order</a>
          </div>
        </div>
      <% }) %>
      <% if (services.length === 0) { %>
        <p class="sub">No services added yet.</p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
