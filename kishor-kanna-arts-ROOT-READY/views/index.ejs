<% if (videos.length) { %>
<section class="section section-tint">
  <div class="container">
    <h2 class="reveal"><%= settings.videos_heading || 'Watch the Art Come Alive' %></h2>
    <p class="sub reveal"><%= settings.videos_sub || 'Experience the passion, precision, and creativity behind every handcrafted portrait.' %></p>
  </div>
  <div class="videos-marquee">
    <div class="videos-track" id="videosTrack">
      <% videos.forEach(v => { %>
        <div class="video-card">
          <div class="card">
            <div class="card-body">
              <h3><%= v.title %></h3>
              <% if (v.embed_url) { %>
                <div class="video-facade" data-embed="<%= v.embed_url %>" style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden; border-radius:8px; cursor:pointer; background:#000 <% if (v.thumb_url) { %>url('<%= v.thumb_url %>') center/cover<% } %>;">
                  <span class="video-play-btn" aria-hidden="true">
                    <svg viewBox="0 0 68 48" width="52" height="37"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
                  </span>
                </div>
              <% } else { %>
                <a class="btn btn-outline" href="<%= v.video_url %>" target="_blank" rel="noopener">Watch Video</a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<script>
  (function () {
    const track = document.getElementById('videosTrack');
    if (!track) return;
    Array.from(track.children).forEach(card => track.appendChild(card.cloneNode(true)));

    function loadFacade(facade, muted) {
      const embed = facade.getAttribute('data-embed');
      const sep = embed.includes('?') ? '&' : '?';
      const params = muted ? 'autoplay=1&mute=1&playsinline=1' : 'autoplay=1&playsinline=1';
      const iframe = document.createElement('iframe');
      iframe.src = embed + sep + params;
      iframe.style.cssText = 'position:absolute; top:0; left:0; width:100%; height:100%; border:0;';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'eager';
      facade.innerHTML = '';
      facade.appendChild(iframe);
      facade.dataset.played = '1';
      facade.dataset.muted = muted ? '1' : '0';
      const marquee = facade.closest('.videos-marquee');
      // Only pause the auto-scroll marquee once a video is actually playing
      // with sound (a deliberate click). The silent scroll-into-view
      // autoplay must never set this, or the very first video to come
      // into view freezes the whole row's auto-scroll permanently.
      if (marquee) {
        if (!muted) marquee.classList.add('playing');
        else marquee.classList.remove('playing');
      }
    }

    const facades = Array.from(track.querySelectorAll('.video-facade'));

    function checkVisibilityFallback() {
      facades.forEach(function (f) {
        if (f.dataset.played) return;
        const r = f.getBoundingClientRect();
        const visible = r.top < window.innerHeight && r.bottom > 0 && r.left < window.innerWidth && r.right > 0;
        if (visible) loadFacade(f, true);
      });
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          const facade = entry.target;
          if (entry.isIntersecting && !facade.dataset.played) {
            loadFacade(facade, true);
          }
        });
      }, { root: null, threshold: 0.25 });
      facades.forEach(function (f) { io.observe(f); });
    }
    checkVisibilityFallback();
    window.addEventListener('scroll', checkVisibilityFallback, { passive: true });
    window.addEventListener('load', checkVisibilityFallback);

    track.addEventListener('click', function (e) {
      const facade = e.target.closest('.video-facade');
      if (!facade) return;
      if (!facade.dataset.played) { loadFacade(facade, true); return; }
      if (facade.dataset.muted === '1') { loadFacade(facade, false); }
    });
  })();
</script>
<% } %>

