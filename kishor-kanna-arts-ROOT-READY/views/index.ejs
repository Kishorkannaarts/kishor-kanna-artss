      <p class="lead hero-anim" style="--d:0.24s"><%= settings.hero_subtitle || "From pencil sketches to colorful masterpieces, we transform your cherished moments into handcrafted artwork you'll treasure forever." %></p>
      <div class="hero-actions hero-anim" style="--d:0.36s">
