<% pageTitle = 'Home' %>
<% pageDescription = settings.meta_description || `${settings.site_name} — custom hand-made pencil, colour and canvas portraits made from your photo. Couple, family, wedding and pet portraits, shipped anywhere in India.` %>
<%- include('partials/header') %>

<section class="hero<%= settings.hero_image_url ? ' hero-with-image' : '' %>">
  <% if (settings.hero_image_url) { %>
    <img class="hero-photo" src="<%= settings.hero_image_url %>" alt="" fetchpriority="high" decoding="async">
    <div class="hero-overlay"></div>
  <% } %>
  <div class="hero-inner">
    <div class="hero-content">
      <span class="hero-eyebrow hero-anim" style="--d:0s">Handmade in India • Since Day One</span>
      <h1 class="hero-anim" style="--d:0.12s"><%= settings.hero_title %></h1>
      <p class="lead hero-anim" style="--d:0.24s"><%= settings.hero_subtitle %></p>
       <div class="hero-actions hero-anim" style="--d:0.36s">
        <a class="btn btn-gold" href="/order">Order Your Artwork</a>
        <a class="btn btn-outline<%= settings.hero_image_url ? ' btn-outline-onimage' : '' %>" href="/portfolio">View Portfolio</a>
      </div>
      <div class="hero-social-proof hero-anim" style="--d:0.48s">
        <div class="hero-avatars">
          <span class="hero-avatar" style="background:#e0b084"></span>
          <span class="hero-avatar" style="background:#c99a3a"></span>
          <span class="hero-avatar" style="background:#b5451b"></span>
          <span class="hero-avatar" style="background:#8c3413"></span>
        </div>
        <span>500+ Happy Customers</span>
      </div>
    </div>
  </div>
  <% if (settings.hero_image_url) { %>
    <div class="hero-scroll-cue" aria-hidden="true"><span></span></div>
  <% } %>
</section>

<!-- Trust bar -->
<section class="trust-bar reveal">
  <div class="container trust-bar-inner">
    <div class="trust-stat"><strong class="count-up" data-count-to="1000" data-suffix="+">0</strong><span>Portraits Delivered</span></div>
    <div class="trust-stat"><strong class="count-up" data-count-to="4.9" data-decimals="1" data-suffix="★">0</strong><span>Average Rating</span></div>
    <div class="trust-stat"><strong class="count-up" data-count-to="28" data-suffix="">0</strong><span>States Shipped To</span></div>
    <div class="trust-stat"><strong class="count-up" data-count-to="100" data-suffix="%">0</strong><span>Hand-made, Never Printed</span></div>
  </div>
</section>

<% if (offers.length) { %>
<div class="container" style="margin-bottom:10px;">
  <% offers.forEach(o => { %>
    <div class="offer-banner reveal">
      <strong><%= o.title %></strong>
      <% if (o.message) { %> — <%= o.message %><% } %>
    </div>
  <% }) %>
</div>
<% } %>

<section class="section">
  <div class="container">
    <h2 class="reveal"><%= settings.featured_heading || 'Featured Portfolio' %></h2>
    <p class="sub reveal"><%= settings.featured_sub || 'A glimpse of recent handcrafted pieces' %></p>
    <div class="grid grid-2 grid-arts">
      <% featured.forEach(a => { %>
        <div class="card reveal">
          <a href="/portfolio/<%= a.id %>">
            <img src="<%= a.image || 'https://placehold.co/400x300?text=Artwork' %>" alt="<%= a.title %>" loading="lazy" decoding="async">
          </a>
          <div class="card-body">
            <span class="tag"><%= a.category %></span>
            <h3><a href="/portfolio/<%= a.id %>" style="color:inherit; text-decoration:none;"><%= a.title %></a></h3>
            <p><%= a.description %></p>
            <div class="card-footer">
              <div class="meta">
                <% if (a.size) { %><span>Size: <strong><%= a.size %></strong></span><% } %>
                <% if (a.price) { %><span style="margin-left:10px;">₹<strong><%= a.price %></strong></span><% } %>
              </div>
              <a class="btn btn-sm btn-primary" href="/order?art_type=<%= encodeURIComponent(a.category) %>&size=<%= encodeURIComponent(a.size || '') %>&price=<%= encodeURIComponent(a.price || '') %>">Order This</a>
            </div>
          </div>
        </div>
      <% }) %>
<% if (featured.length === 0) { %>
        <p class="sub">No artworks added yet — add some from the admin panel.</p>
      <% } %>
    </div>
  </div>
</section>

<% if (beforeAfter && beforeAfter.length > 0) { %>
<section class="section section-tint">
  <div class="container">
    <h2 class="reveal">Before &amp; After</h2>
    <p class="sub reveal">Drag the slider to see the photo become the artwork</p>
    <div class="grid grid-2 grid-ba">
      <% beforeAfter.forEach(a => { %>
        <div class="ba-item reveal">
          <div class="ba-slider" data-ba>
            <img class="ba-after" src="<%= a.image %>" alt="<%= a.title %> — finished artwork" loading="lazy" decoding="async">
            <img class="ba-before" src="<%= a.before_image %>" alt="<%= a.title %> — original reference photo" loading="lazy" decoding="async">
            <div class="ba-handle" aria-hidden="true"></div>
            <span class="ba-label ba-label-before">Photo</span>
            <span class="ba-label ba-label-after">Artwork</span>
            <input type="range" class="ba-range" min="0" max="100" value="50" aria-label="Drag to compare the photo and the finished artwork for <%= a.title %>">
          </div>
          <h3 style="margin:10px 0 0; font-size:1.05rem;"><%= a.title %></h3>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll('[data-ba]').forEach(function (el) {
    var range = el.querySelector('.ba-range');
    var beforeImg = el.querySelector('.ba-before');
    var handle = el.querySelector('.ba-handle');
    function update() {
      beforeImg.style.clipPath = 'inset(0 ' + (100 - range.value) + '% 0 0)';
      handle.style.left = range.value + '%';
    }
    range.addEventListener('input', update);
    update();
  });
</script>
<% } %>

<section class="section section-tint">
  <div class="container">
    <h2 class="reveal"><%= settings.services_heading || 'Services' %></h2>
    <p class="sub reveal"><%= settings.services_sub || 'Custom art made to order' %></p>
    <div class="grid grid-2 grid-services">
      <% services.forEach(s => { %>
        <div class="card reveal">
          <img src="<%= s.image || 'https://placehold.co/400x300?text=Service' %>" alt="<%= s.title %>" loading="lazy" decoding="async">
          <div class="card-body">
            <h3><%= s.title %></h3>
            <p><%= s.description %></p>
            <a class="btn btn-outline" href="/order">Order This</a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Process timeline -->
<section class="section">
  <div class="container">
    <h2 class="reveal">How It Works</h2>
    <p class="sub reveal">From your photo to your wall in 4 simple steps</p>
    <div class="timeline">
      <div class="timeline-step reveal">
        <div class="timeline-num">1</div>
        <h3>Choose &amp; Upload</h3>
        <p>Pick your art type, size, and upload the photo you love.</p>
      </div>
      <div class="timeline-step reveal">
        <div class="timeline-num">2</div>
        <h3>We Create</h3>
        <p>Our artist hand-draws or paints your portrait with care.</p>
      </div>
      <div class="timeline-step reveal">
        <div class="timeline-num">3</div>
        <h3>You Track It</h3>
        <p>Watch live progress updates, right from your dashboard.</p>
      </div>
      <div class="timeline-step reveal">
        <div class="timeline-num">4</div>
        <h3>Delivered</h3>
        <p>Safely packed and shipped straight to your door.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="container">
    <h2 class="reveal"><%= settings.why_heading || 'Why Choose Us' %></h2>
    <div class="grid grid-2">
      <div class="card reveal"><div class="card-body"><h3><%= settings.why1_title || '100% Hand-made' %></h3><p><%= settings.why1_text || 'Every artwork is drawn or painted by hand, never printed.' %></p></div></div>
      <div class="card reveal"><div class="card-body"><h3><%= settings.why2_title || 'Made From Your Photos' %></h3><p><%= settings.why2_text || 'Send a photo and we turn it into a keepsake artwork.' %></p></div></div>
      <div class="card reveal"><div class="card-body"><h3><%= settings.why3_title || 'Tracked Orders' %></h3><p><%= settings.why3_text || 'Follow your order status from start to delivery.' %></p></div></div>
      <div class="card reveal"><div class="card-body"><h3><%= settings.why4_title || 'Nationwide Delivery' %></h3><p><%= settings.why4_text || 'Carefully packed and shipped anywhere in India.' %></p></div></div>
    </div>
  </div>
</section>

<% if (typeof blocks !== 'undefined' && blocks.length) { %>
<section class="section">
  <div class="container">
    <h2 class="reveal">More From Us</h2>
    <div class="grid grid-3">
      <% blocks.forEach(b => { %>
        <div class="card reveal"><div class="card-body"><h3><%= b.title %></h3><p><%= b.text %></p></div></div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (videos.length) { %>
<section class="section section-tint">
  <div class="container">
    <h2 class="reveal"><%= settings.videos_heading || 'Videos' %></h2>
    <p class="sub reveal"><%= settings.videos_sub || 'Watch the artwork process' %></p>
  </div>
  <div class="videos-marquee">
    <div class="videos-track" id="videosTrack">
      <% videos.forEach(v => { %>
        <div class="video-card">
          <div class="card">
            <div class="card-body">
              <h3><%= v.title %></h3>
              <% if (v.embed_url) { %>
                <div class="video-facade" data-embed="<%= v.embed_url %>" style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden; border-radius:8px; cursor:pointer; background:#000 <% if (v.thumb_url) { %>url('<%= v.thumb_url %>') center/cover<% } %>;">
                  <span class="video-play-btn" aria-hidden="true">
                    <svg viewBox="0 0 68 48" width="52" height="37"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
                  </span>
                </div>
              <% } else { %>
                <a class="btn btn-outline" href="<%= v.video_url %>" target="_blank" rel="noopener">Watch Video</a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<script>
  (function () {
    const track = document.getElementById('videosTrack');
    if (!track) return;
    Array.from(track.children).forEach(card => track.appendChild(card.cloneNode(true)));

    function loadFacade(facade, muted) {
    function loadFacade(facade, muted) {
      const embed = facade.getAttribute('data-embed');
      const sep = embed.includes('?') ? '&' : '?';
      const params = muted ? 'autoplay=1&mute=1&playsinline=1' : 'autoplay=1&playsinline=1';
      const iframe = document.createElement('iframe');
      iframe.src = embed + sep + params;
      iframe.style.cssText = 'position:absolute; top:0; left:0; width:100%; height:100%; border:0;';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'eager';
      facade.innerHTML = '';
      facade.appendChild(iframe);
      facade.dataset.played = '1';
      facade.dataset.muted = muted ? '1' : '0';
      // Stop the row from sliding a playing video off-screen.
      const marquee = facade.closest('.videos-marquee');
      if (marquee) marquee.classList.add('playing');
    }

    const facades = Array.from(track.querySelectorAll('.video-facade'));

    // Belt-and-suspenders visibility check: some mobile browsers delay or
    // never fire IntersectionObserver callbacks reliably for elements inside
    // a horizontally-animating row. This manual check runs alongside the
    // observer and catches anything it misses.
    function checkVisibilityFallback() {
      facades.forEach(function (f) {
        if (f.dataset.played) return;
        const r = f.getBoundingClientRect();
        const visible = r.top < window.innerHeight && r.bottom > 0 && r.left < window.innerWidth && r.right > 0;
        if (visible) loadFacade(f, true);
      });
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          const facade = entry.target;
          if (entry.isIntersecting && !facade.dataset.played) {
            loadFacade(facade, true);
          }
        });
      }, { root: null, threshold: 0.25 });
      facades.forEach(function (f) { io.observe(f); });
    }
    // Always also run the manual check on load and on scroll, in case the
    // observer never fires (older/low-power mobile browsers).
    checkVisibilityFallback();
    window.addEventListener('scroll', checkVisibilityFallback, { passive: true });
    window.addEventListener('load', checkVisibilityFallback);

    track.addEventListener('click', function (e) {
      const facade = e.target.closest('.video-facade');
      if (!facade) return;
      if (!facade.dataset.played) { loadFacade(facade, true); return; }
      if (facade.dataset.muted === '1') { loadFacade(facade, false); }
    });
  })();
</script>
<% } %>

<% if (testimonials.length) { %>
<section class="section">
  <div class="container">
    <h2 class="reveal"><%= settings.reviews_heading || 'Reviews' %></h2>
    <p class="sub reveal"><%= settings.reviews_sub || 'What our customers say' %></p>
  </div>
  <div class="reviews-marquee">
    <div class="reviews-track" id="reviewsTrack">
      <% testimonials.forEach(t => { %>
        <%- include('partials/testimonial-card', { t }) %>
      <% }) %>
    </div>
  </div>
</section>
<script>
  (function () {
    function timeAgo(iso) {
      const diff = Date.now() - new Date(iso).getTime();
      const day = 86400000;
      const days = Math.floor(diff / day);
      if (days <= 0) return 'Today';
      if (days === 1) return '1 day ago';
      if (days < 30) return days + ' days ago';
      const months = Math.floor(days / 30);
      if (months < 12) return months + (months === 1 ? ' month ago' : ' months ago');
      const years = Math.floor(months / 12);
      return years + (years === 1 ? ' year ago' : ' years ago');
    }
    document.querySelectorAll('.review-date[data-created]').forEach(el => {
      el.textContent = timeAgo(el.getAttribute('data-created'));
    });

    const track = document.getElementById('reviewsTrack');
    if (!track) return;
    Array.from(track.children).forEach(card => track.appendChild(card.cloneNode(true)));
  })();
</script>
<% } %>

<% if (typeof galleryPhotos !== 'undefined' && galleryPhotos.length) { %>
<section class="section">
  <div class="container">
    <h2 class="reveal">Customer Gallery</h2>
    <p class="sub reveal">Real portraits, in real homes — shared by the people who ordered them.</p>
    <div class="gallery-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:14px; margin-top:20px;">
      <% galleryPhotos.forEach(p => { %>
        <a href="/gallery" style="display:block; aspect-ratio:1; border-radius:10px; overflow:hidden;">
          <img src="<%= p.photo_url %>" alt="Photo shared by <%= p.name %>" loading="lazy" decoding="async" style="width:100%; height:100%; object-fit:cover;">
        </a>
      <% }) %>
    </div>
    <div style="text-align:center; margin-top:24px;">
      <a class="btn btn-outline" href="/gallery">View Full Gallery</a>
    </div>
  </div>
</section>
<% } %>

<% if (typeof recentPosts !== 'undefined' && recentPosts.length) { %>
<section class="section section-tint">
  <div class="container">
    <h2 class="reveal">From the Blog</h2>
    <p class="sub reveal">Tips, stories, and behind-the-scenes</p>
    <div class="grid grid-3">
      <% recentPosts.forEach(p => { %>
        <a class="card reveal" href="/blog/<%= p.slug %>" style="text-decoration:none; color:inherit;">
          <img src="<%= p.cover_image || 'https://placehold.co/400x300?text=Blog' %>" alt="<%= p.title %>" loading="lazy" decoding="async">
          <div class="card-body">
            <h3><%= p.title %></h3>
            <p><%= p.excerpt %></p>
          </div>
        </a>
      <% }) %>
    </div>
    <div style="text-align:center; margin-top:24px;"><a class="btn btn-outline" href="/blog">View All Posts</a></div>
  </div>
</section>
<% } %>

<section class="section section-tint cta-final" style="text-align:center;">
  <div class="container">
    <h2 class="reveal"><%= settings.cta_title || 'Ready to Order Your Custom Artwork?' %></h2>
    <p class="sub reveal"><%= settings.cta_subtitle || "Tell us your idea — we'll bring it to life." %></p>
    <a class="btn btn-gold reveal" href="/order"><%= settings.cta_button_text || 'Start Your Order' %></a>
  </div>
</section>

<%- include('partials/footer') %>
